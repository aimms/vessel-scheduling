<AimmsJSONMapping>
    <ObjectMapping>
        <ArrayMapping  name="inputs" >
			<ObjectMapping>
				<ValueMapping name="tab" binds-to="modSolveService::i_ift"/>
				<ValueMapping  name="file" maps-to="modSolveService::sp_inputFileNames(modSolveService::i_ift)"/>
			</ObjectMapping>
        </ArrayMapping>
        <ArrayMapping  name="outputs" >
			<ObjectMapping>
				<ValueMapping name="tab" binds-to="modSolveService::i_oft"/>
				<ValueMapping name="file" maps-to="modSolveService::sp_outputFileNames(modSolveService::i_oft)"/>
			</ObjectMapping>
        </ArrayMapping>
    </ObjectMapping>
</AimmsJSONMapping>