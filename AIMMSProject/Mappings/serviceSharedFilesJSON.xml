<AimmsJSONMapping>
    <ObjectMapping>
        <ArrayMapping  name="inputs" >
			<ObjectMapping>
				<ValueMapping name="tab" binds-to="modSolveService::i_ifn"/>
				<ValueMapping  name="file" maps-to="modSolveService::sp_inputFileNames(modSolveService::i_ifn)"/>
			</ObjectMapping>
        </ArrayMapping>
        <ArrayMapping  name="outputs" >
			<ObjectMapping>
				<ValueMapping name="tab" binds-to="modSolveService::i_ofn"/>
				<ValueMapping name="file" maps-to="modSolveService::sp_outputFileNames(modSolveService::i_ofn)"/>
			</ObjectMapping>
        </ArrayMapping>
    </ObjectMapping>
</AimmsJSONMapping>