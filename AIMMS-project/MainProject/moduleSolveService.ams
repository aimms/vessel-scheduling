## ams_version=1.0

Module Module_SolveService {
	Prefix: modSolveService;
	Comment: "Exposes the vessel scheduling solver as DEX REST API services and background tasks, supporting Excel, CSV, Parquet, and shared-file input/output formats.";
	Parameter bp_cleanup {
		Range: binary;
		InitialData: 1;
		Comment: "When 1 (default), intermediate working folders and ZIP files are deleted after service execution to keep the project folder clean.";
	}
	Procedure pr_initTask {
		Comment: "Resets the business model by emptying core sets and deleting all generated mathematical programs, preparing for a fresh solve.";
		Body: {
			! Reset the Business model
			empty s_cargoes, s_vessels, s_locations, s_calc_feasibleRoutes ;
			!empty Business_model;
			
			! Clean the generated mathematical programs.
			_ep_gmp := first( AllGeneratedMathematicalPrograms );
			while _ep_gmp do
				gmp::Instance::Delete( _ep_gmp );
			endwhile ;
			
			!! Other cleanups
			!GarbageCollectStrings();
			!CleanDependents;
			!
		}
		ElementParameter _ep_gmp {
			Range: AllGeneratedMathematicalPrograms;
		}
	}
	Section Service_solveVesselSchedulingExcel {
		Comment: "DEX REST service that accepts an Excel file as request body, solves the vessel scheduling model, and returns results as an Excel file.";
		Procedure pr_solveVesselSchedulingExcel {
			Comment: "DEX REST service entry point for the Excel format: initializes the task, reads request/response paths from DEX, delegates to pr_actuallySolveVesselSchedulingExcel, and handles errors.";
			Body: {
				block
				
					pr_initTask();
				
					_sp_inp := dex::api::RequestAttribute( 'request-data-path'  ) ;
					_sp_out := dex::api::RequestAttribute( 'response-data-path' ) ;
				
					pr_actuallySolveVesselSchedulingExcel( _sp_inp, _sp_out );
				
				onerror _ep_err do
				
					_sp_msg := errh::Message( _ep_err );
					display _sp_msg ;
					if pro::GetPROEndPoint() then
						pro::management::LocalLogInfo("Error message: " + _sp_msg );
						errh::MarkAsHandled(_ep_err);
					endif ;
				
				endblock ;
				
				return 1 ;
			}
			dex::ServiceName: solveVesselSchedulingExcel;
			StringParameter _sp_inp;
			StringParameter _sp_out;
			ElementParameter _ep_err {
				Range: errh::PendingErrors;
			}
			StringParameter _sp_msg;
		}
		Procedure pr_actuallySolveVesselSchedulingExcel {
			Arguments: (sp_inp,sp_out);
			Comment: "Reads input data from the Excel file sp_inp, activates all master data, generates routes and costs, solves the model, extracts results, and writes output to the Excel file sp_out.";
			Body: {
				! Add the DEX mapping for the Excel import dataset
				dex::AddMapping(
					mappingName : "ImportDataSet",
					mappingFile : "Mappings/Generated/ImportDataSet-Excel.xml");
				
				p_vesselVelocity := 37.04 [km/hour];
				
				if dex::ReadFromFile(
					dataFile    : sp_inp, 
					mappingName : "Generated/ImportDataSet-Excel") then
				
					!Activate all master data
					bp_activeCargoes(i_cargo):= 1;
					bp_activeVessels(i_vessel) := 1;
					bp_activeLocations(i_loc) := 1;
				endif ;
				
				pr_calculateRoutesAndCost(ep_routeCalculationImplementation: ep_selectedRouteCalculationImplementation );
				
				solve mm::mp_vesselScheduling;
				
				!Post Execution
				mm::pr_post_vesselResults();
				mm::pr_post_cargoResults();
				mm::pr_post_routeResults();
				
				dex::WriteToFile(
					dataFile    :  sp_out, 
					mappingName :  "Generated/ExportDataSet-Excel", 
					pretty      :  1);
			}
			DeclarationSection Argument_declarations {
				StringParameter sp_inp {
					Property: Input;
				}
				StringParameter sp_out {
					Property: Input;
				}
			}
		}
		Procedure pr_taskSolveVesselSchedulingExcel {
			Comment: "Registers pr_actuallySolveVesselSchedulingExcel as a background task under the name 'taskSolveVesselSchedulingExcel' for asynchronous execution.";
			dex::TaskName: taskSolveVesselSchedulingExcel;
		}
	}
	Section Service_solveVesselSchedulingCSV {
		Comment: "DEX REST service that accepts a ZIP of CSV files as request body, solves the vessel scheduling model, and returns results as a ZIP of CSV files.";
		Procedure pr_solveVesselSchedulingCSV {
			Comment: "DEX REST service entry point for the CSV format: initializes the task, reads request/response paths from DEX, delegates to pr_actuallySolveVesselSchedulingCSV, and handles errors.";
			Body: {
				block
				
					pr_initTask();
				
					_sp_inp := dex::api::RequestAttribute( 'request-data-path'  ) ;
					_sp_out := dex::api::RequestAttribute( 'response-data-path' ) ;
				
					pr_actuallySolveVesselSchedulingCSV( _sp_inp, _sp_out );
				
				onerror _ep_err do
				
					_sp_msg := errh::Message( _ep_err );
					display _sp_msg ;
				
				endblock ;
				
				return 1 ;
			}
			dex::ServiceName: solveVesselSchedulingCSV;
			StringParameter _sp_inp;
			StringParameter _sp_out;
			ElementParameter _ep_err {
				Range: errh::PendingErrors;
			}
			StringParameter _sp_msg;
		}
		Procedure pr_actuallySolveVesselSchedulingCSV {
			Arguments: (sp_inp,sp_out);
			Comment: "Unzips the input ZIP (sp_inp) containing CSV files, reads each CSV table, activates master data, solves the model, extracts results, writes output CSV files, zips them, and copies the ZIP to sp_out.";
			Body: {
				p_vesselVelocity := 37.04 [km/hour];

				block ! Get the request body in the AIMMS project folder, and unzip it.
					if DirectoryExists( "csvinp" ) then
						DirectoryDelete( "csvinp" );
					endif ;
					If FileExists( "csvinp.zip" ) then
						FileDelete( "csvinp.zip" );
					endif ;
					FileCopy( sp_inp, "csvinp.zip");
					zip::pr_unzipFileToFolder(
						sp_fileName              :  "csvinp.zip", 
						sp_destinationFolderName :  "csvinp");
					_sp_folderName := "csvinp/csv/" ;
				endblock ;
				
				
				block ! Read in the data
				
					_p_ok := 1 ;
					_p_ok := _p_ok AND dex::ReadFromFile(
						dataFile    : _sp_folderName + "Horizon.csv", 
						mappingName : "Generated/ImportDataSet-Horizon-CSV");
					_p_ok := _p_ok AND dex::ReadFromFile(
						dataFile    : _sp_folderName + "VesselData.csv", 
						mappingName : "Generated/ImportDataSet-VesselData-CSV");
					_p_ok := _p_ok AND dex::ReadFromFile(
						dataFile    : _sp_folderName + "CargoData.csv", 
						mappingName : "Generated/ImportDataSet-CargoData-CSV");
					_p_ok := _p_ok AND dex::ReadFromFile(
						dataFile    : _sp_folderName + "LocationData.csv", 
						mappingName : "Generated/ImportDataSet-LocationData-CSV");
				
				endblock ;
				
				block ! Cleanup intermediate folders and files after reading.
					if DirectoryExists( "csvinp" ) then
						DirectoryDelete( "csvinp" );
					endif ;
					If FileExists( "csvinp.zip" ) then
						FileDelete( "csvinp.zip" );
					endif ;
				endblock ;
				
				! display s_vessels, s_cargoes ;
				
				if _p_ok then
				
					!Activate all master data
					bp_activeCargoes(i_cargo):= 1;
					bp_activeVessels(i_vessel) := 1;
					bp_activeLocations(i_loc) := 1;
				
					pr_calculateRoutesAndCost(ep_routeCalculationImplementation: ep_selectedRouteCalculationImplementation);
				
					solve mm::mp_vesselScheduling;
				
					!Post Execution
					mm::pr_post_vesselResults();
					mm::pr_post_cargoResults();
					mm::pr_post_routeResults();
				
				endif ;
				
				block ! put Output csv file in a separate folder and zip it.
					_sp_folderName := "csvout" ;
					if DirectoryExists( _sp_folderName ) then ! remove old contents, if any.
						DirectoryDelete( _sp_folderName );
					endif ;
					DirectoryCreate( _sp_folderName );
					_sp_folderNameSlash := _sp_folderName + "/" ;
					dex::WriteToFile(
						dataFile    :  _sp_folderNameSlash + "Cargo Overview.csv", 
						mappingName :  "Generated/ExportDataSet-Cargo Overview-CSV", 
						pretty      :  1);
					dex::WriteToFile(
						dataFile    :  _sp_folderNameSlash + "Route Overview.csv", 
						mappingName :  "Generated/ExportDataSet-Route Overview-CSV", 
						pretty      :  1);
					dex::WriteToFile(
						dataFile    :  _sp_folderNameSlash + "Vessel Overview.csv", 
						mappingName :  "Generated/ExportDataSet-Vessel Overview-CSV", 
						pretty      :  1);
					_sp_filename := _sp_folderName + ".zip" ;
					zip::pr_zipFolderToFile(
						sp_folderName      :  _sp_folderName, 
						sp_destinationFile :  _sp_filename );
					FileCopy( _sp_filename, sp_out );
					if bp_cleanup then
						FileDelete( _sp_filename );
						DirectoryDelete( _sp_folderName );
					endif ;
					if bp_cleanup then
						FileDelete( _sp_filename );
						DirectoryDelete( _sp_folderName );
					endif ;
				endblock ;
			}
			DeclarationSection Argument_declarations {
				StringParameter sp_inp {
					Property: Input;
				}
				StringParameter sp_out {
					Property: Input;
				}
				StringParameter _sp_folderName;
				StringParameter _sp_folderNameSlash;
				Parameter _p_ok;
				StringParameter _sp_filename;
			}
		}
	}
	Section Service_solveVesselSchedulingParquet {
		Comment: "DEX REST service that accepts a ZIP of Parquet files as request body, solves the vessel scheduling model, and returns results as a ZIP of Parquet files.";
		Procedure pr_solveVesselSchedulingParquet {
			Comment: "DEX REST service entry point for the Parquet format: initializes the task, reads request/response paths from DEX, delegates to pr_actuallySolveVesselSchedulingParquet, and handles errors.";
			Body: {
				block
				
					pr_initTask();
				
					_sp_inp := dex::api::RequestAttribute( 'request-data-path'  ) ;
					_sp_out := dex::api::RequestAttribute( 'response-data-path' ) ;
				
					pr_actuallySolveVesselSchedulingParquet( _sp_inp, _sp_out );
				
				onerror _ep_err do
				
					_sp_msg := errh::Message( _ep_err );
					display _sp_msg ;
				
				endblock ;
				
				return 1 ;
			}
			dex::ServiceName: solveVesselSchedulingParquet;
			StringParameter _sp_inp;
			StringParameter _sp_out;
			ElementParameter _ep_err {
				Range: errh::PendingErrors;
			}
			StringParameter _sp_msg;
		}
		Procedure pr_actuallySolveVesselSchedulingParquet {
			Arguments: (sp_inp,sp_out);
			Comment: "Unzips the input ZIP (sp_inp) containing Parquet files, reads each Parquet table, activates master data, solves the model, extracts results, writes output Parquet files, zips them, and copies the ZIP to sp_out.";
			Body: {
				p_vesselVelocity := 37.04 [km/hour];

				block ! Get the request body in the AIMMS project folder, and unzip it.
					if DirectoryExists( "parquetinp" ) then
						DirectoryDelete( "parquetinp" );
					endif ;
					If FileExists( "parquetinp.zip" ) then
						FileDelete( "parquetinp.zip" );
					endif ;
					FileCopy( sp_inp, "parquetinp.zip");
					zip::pr_unzipFileToFolder(
						sp_fileName              :  "parquetinp.zip", 
						sp_destinationFolderName :  "parquetinp");
					_sp_folderName := "parquetinp/parquet/" ;
					pr_logContentsCurrentFolder( "", 1);
				
					if AimmsStringConstants('Platform' ) = "Linux" then
						pr_logContentsCurrentFolder( "/usr", 0);
						pr_logContentsCurrentFolder( "/usr/bin", 0);
						pr_logContentsCurrentFolder( "/usr/local/bin", 0);
					endif;
				
				endblock ;
				
				
				block ! Read in the data 
				
					_p_ok := 1 ;
					_p_ok := _p_ok AND dex::ReadFromFile(
						dataFile    : _sp_folderName + "Horizon.parquet", 
						mappingName : "Generated/ImportDataSet-Horizon-Parquet");
					_p_ok := _p_ok AND dex::ReadFromFile(
						dataFile    : _sp_folderName + "VesselData.parquet", 
						mappingName : "Generated/ImportDataSet-VesselData-Parquet");
					_p_ok := _p_ok AND dex::ReadFromFile(
						dataFile    : _sp_folderName + "CargoData.parquet", 
						mappingName : "Generated/ImportDataSet-CargoData-Parquet");
					_p_ok := _p_ok AND dex::ReadFromFile(
						dataFile    : _sp_folderName + "LocationData.parquet", 
						mappingName : "Generated/ImportDataSet-LocationData-Parquet");
				
				endblock ;
				
				block ! Cleanup intermediate folders and files after reading.
					if DirectoryExists( "parquetinp" ) then
						DirectoryDelete( "parquetinp" );
					endif ;
					If FileExists( "parquetinp.zip" ) then
						FileDelete( "parquetinp.zip" );
					endif ;
				endblock ;
				
				! display s_vessels, s_cargoes ;
				
				if _p_ok then
				
					!Activate all master data
					bp_activeCargoes(i_cargo):= 1;
					bp_activeVessels(i_vessel) := 1;
					bp_activeLocations(i_loc) := 1;
				
					pr_calculateRoutesAndCost(ep_routeCalculationImplementation: ep_selectedRouteCalculationImplementation);
				
					solve mm::mp_vesselScheduling;
				
					!Post Execution
					mm::pr_post_vesselResults();
					mm::pr_post_cargoResults();
					mm::pr_post_routeResults();
				
				endif ;
				
				block ! put Output Parquet file in a separate folder and zip it.
					_sp_folderName := "parquetout" ;
					if DirectoryExists( _sp_folderName ) then ! remove old contents, if any.
						DirectoryDelete( _sp_folderName );
					endif ;
					DirectoryCreate( _sp_folderName );
					_sp_folderNameSlash := _sp_folderName + "/" ;
					dex::WriteToFile(
						dataFile    :  _sp_folderNameSlash + "Cargo Overview.parquet", 
						mappingName :  "Generated/ExportDataSet-Cargo Overview-Parquet", 
						pretty      :  1);
					dex::WriteToFile(
						dataFile    :  _sp_folderNameSlash + "Route Overview.parquet", 
						mappingName :  "Generated/ExportDataSet-Route Overview-Parquet", 
						pretty      :  1);
					dex::WriteToFile(
						dataFile    :  _sp_folderNameSlash + "Vessel Overview.parquet", 
						mappingName :  "Generated/ExportDataSet-Vessel Overview-Parquet", 
						pretty      :  1);
					_sp_filename := _sp_folderName + ".zip" ;
					zip::pr_zipFolderToFile(
						sp_folderName      :  _sp_folderName, 
						sp_destinationFile :  _sp_filename );
					FileCopy( _sp_filename, sp_out );
					if bp_cleanup then
						FileDelete( _sp_filename );
						DirectoryDelete( _sp_folderName );
					endif ;
				endblock ;
			}
			DeclarationSection Argument_declarations {
				StringParameter sp_inp {
					Property: Input;
				}
				StringParameter sp_out {
					Property: Input;
				}
				StringParameter _sp_folderName;
				StringParameter _sp_folderNameSlash;
				Parameter _p_ok;
				StringParameter _sp_filename;
			}
		}
	}
	Section Service_solveVesselSchedulingSharedFiles {
		Comment: {
			"Requires: there is a storage location to which both the client and server have access to.
			
			Request:
			Multiple filenames passed for input, 
			and multiple filenames passed for output.
			
			Important: the tab names should correspond to the table names 
			in the dex::TableName attribute, and thereby with the generated mapping files.
			
			
			Response:
			Just the response code."
		}
		Set s_inputFileTables {
			SubsetOf: dex::Tables;
			Index: i_ift;
			Comment: "Set of DEX table names that belong to the ImportDataSet, representing the input tables expected in the shared-files service request.";
			Definition: {
				{ dex::tbl | dex::DatasetTableMapping('ImportDataSet',dex::tbl) }
			}
		}
		Set s_outputFileTables {
			SubsetOf: dex::Tables;
			Index: i_oft;
			Comment: "Set of DEX table names that belong to the ExportDataSet, representing the output tables to be written by the shared-files service.";
			Definition: {
				{ dex::tbl | dex::DatasetTableMapping('ExportDataSet',dex::tbl) }
			}
		}
		StringParameter sp_inputFileNames {
			IndexDomain: i_ift;
			Comment: "Filename (including path) of the input CSV file for each table in s_inputFileTables, passed by the caller via the service request JSON.";
		}
		StringParameter sp_outputFileNames {
			IndexDomain: i_oft;
			Comment: "Filename (including path) of the output CSV file for each table in s_outputFileTables, passed by the caller via the service request JSON.";
		}
		StringParameter sp_responseSummaryMessage {
			Comment: "Summary message written into the response JSON body after a successful shared-files solve.";
		}
		Procedure pr_testAllSolveSchedulingSharedFiles {
			Comment: "Iterates over all test samples defined in s_testSamples and calls pr_testSolveSchedulingSharedFiles for each, showing a progress dialog.";
			Body: {
				for i_test do ! | i_test = last( s_testSamples ) do
					DialogProgress(
						message    :  formatSTring("Testing %e - %i/%i", i_test, ord(i_test), card(i_test) ), 
						percentage :  (100*ord(i_test))/card(s_testSamples));
					pr_testSolveSchedulingSharedFiles(formatString("%e",i_test));
				endfor ;
			}
		}
		Procedure pr_testSolveSchedulingSharedFiles {
			Arguments: sp_main;
			Comment: "Test procedure that sets up input/output file paths for dataset sp_main in CSV format, writes the request JSON, then calls pr_actuallySolveVesselSchedulingSharedFiles to run the full solve pipeline.";
			Body: {
				! Selecting test
				!sp_main := "VS_70Vessel_100Cargo" ;
				sp_fileSfx := "csv" ;
				
				! Using the data folder of this AIMMS Project.
				_sp_folderName := "data/" + sp_main + "/" + sp_fileSfx + "/" ;
				
				! Setting the input/output files accordingly.
				sp_inputFileNames(i_ift) := formatString("%s%e.%s", 
					_sp_folderName, i_ift, sp_fileSfx);
				sp_outputFileNames(i_oft) := formatString("%s%e.%s", 
					_sp_folderName, i_oft, sp_fileSfx);
				
				! Passing all this info to a JSON file.
				dex::WriteToFile(
					dataFile    :  "RequestsResponses/sharedFilesTest.json", 
					mappingName :  "serviceSharedFilesJSON", 
					pretty      :  1);
				
				! And let the workhorse play with it.
				pr_initTask();
				pr_actuallySolveVesselSchedulingSharedFiles(
					sp_inp :  "RequestsResponses/sharedFilesTest.json", 
					sp_out :  "RequestsResponses/sharedFilesResponse.json");
			}
			StringParameter _sp_folderName;
			StringParameter sp_fileSfx;
			StringParameter sp_main {
				Property: Input;
			}
		}
		Procedure pr_solveVesselSchedulingSharedFiles {
			Comment: "DEX REST service entry point for the shared-files format: initializes the task, reads request/response paths from DEX, delegates to pr_actuallySolveVesselSchedulingSharedFiles, and handles errors.";
			Body: {
				block

					pr_initTask();

					_sp_inp := dex::api::RequestAttribute( 'request-data-path'  ) ;
					_sp_out := dex::api::RequestAttribute( 'response-data-path' ) ;

					pr_actuallySolveVesselSchedulingSharedFiles( _sp_inp, _sp_out );
				
				onerror _ep_err do
				
					_sp_msg := errh::Message( _ep_err );
					display _sp_msg ;
				
				endblock ;
				
				return 1 ;
			}
			dex::ServiceName: solveVesselSchedulingSharedFiles;
			StringParameter _sp_inp;
			StringParameter _sp_out;
			ElementParameter _ep_err {
				Range: errh::PendingErrors;
			}
			StringParameter _sp_msg;
		}
		Procedure pr_actuallySolveVesselSchedulingSharedFiles {
			Arguments: (sp_inp,sp_out);
			Comment: "Reads shared-files request JSON (sp_inp) to obtain per-table input file paths, reads each CSV input table, activates master data, solves the model, extracts results, writes output CSV files to the specified paths, and writes a response JSON to sp_out.";
			Body: {
				p_vesselVelocity := 37.04 [km/hour];
				
				dex::ReadFromFile(
					dataFile         :  sp_inp, 
					mappingName      :  "serviceSharedFilesJSON", 
					emptyIdentifiers :  0, 
					emptySets        :  0, 
					resetCounters    :  0);
				
				! Read each of the input files.
				_p_ok := 1;
				for i_ift do
				
					!if endsin 
					_sp_mappingName := formatString("Generated/ImportDataSet-%e-CSV", i_ift);
				
					block ! sanity checking
						if not _sp_mappingName in dex::Mappings then
							raise error formatString("A mapping for table %e was not generated", i_ift );
						endif ;
						if not FileExists( sp_inputFileNames(i_ift) ) then
							raise error formatString("For table %e, the input file %s does not exist", 
								i_ift, sp_inputFileNames(i_ift) );
						endif ;
					endblock ;
				
					_p_ok := _p_ok and dex::ReadFromFile(
						dataFile         :  sp_inputFileNames(i_ift), 
						mappingName      :  _sp_mappingName, 
						emptyIdentifiers :  0, 
						emptySets        :  0, 
						resetCounters    :  0);
				
				endfor ;
				
				! display s_vessels, s_cargoes ;
				
				if _p_ok then
				
					!Activate all master data
					bp_activeCargoes(i_cargo):= 1;
					bp_activeVessels(i_vessel) := 1;
					bp_activeLocations(i_loc) := 1;
				
					pr_calculateRoutesAndCost(ep_routeCalculationImplementation: ep_selectedRouteCalculationImplementation);
				
					solve mm::mp_vesselScheduling;
				
					!Post Execution
					mm::pr_post_vesselResults();
					mm::pr_post_cargoResults();
					mm::pr_post_routeResults();
				
				endif ;
				
				! Write all of the output tables.
				!DebuggerBreakpoint();
				for i_oft do
				
					! Example: "Generated/ExportDataSet-Cargo Overview-CSV"
					_sp_mappingName := formatString("Generated/ExportDataSet-%e-CSV", i_oft);
					block ! sanity checking
						if not _sp_mappingName in dex::Mappings then
							raise error formatString("A mapping for table %e was not generated", i_oft );
						endif ;
					endblock ;
				
					if FileExists( sp_outputFileNames( i_oft ) ) then
						FileDelete( sp_outputFileNames( i_oft ) );
					endif ;
				
					dex::WriteToFile(
						dataFile    :  sp_outputFileNames( i_oft ), 
						mappingName :  _sp_mappingName, 
						pretty      :  0);
				
				endfor ;
				
				! Need to write some response body.
				sp_responseSummaryMessage := "medium to well done" ;
				dex::WriteToFile(
					dataFile    :  sp_out, 
					mappingName :  "servicesSharedFilesResponseJSON", 
					pretty      :  0);
			}
			DeclarationSection Argument_declarations {
				StringParameter sp_inp {
					Property: Input;
				}
				StringParameter sp_out {
					Property: Input;
				}
				StringParameter _sp_folderName;
				StringParameter _sp_folderNameSlash;
				Parameter _p_ok;
				StringParameter _sp_filename;
				StringParameter _sp_mappingName;
			}
		}
	}
	Section Service_stopSoon {
		Comment: "DEX REST service that instructs the running REST server to stop accepting new requests after the current one completes.";
		Procedure pr_stopsoon {
			Comment: "Sets the REST service request limit and timeout to 1 to cause the service to shut down gracefully after the current request.";
			Body: {
				dex::api::RESTServiceMaxRequests := 1 ;
				dex::api::RESTServiceTimeout     := 1 ;
				
				return 1 ;
			}
			dex::ServiceName: stopsoon;
		}
	}
}
