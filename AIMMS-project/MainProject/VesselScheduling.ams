## ams_version=1.0

Model Main_VesselScheduling {
	Section Quantities_and_Units {
		Comment: {
			"This section contains all the units and quantities that are added automatically by AIMMS.
			It is recommended to declare all your quantities here."
		}
		Quantity SI_Time_Duration {
			BaseUnit: s;
			Conversions: {
				day->s : #-># * 86400,
				minute->s : #-># * 60,
				century->s : #-># * 3153600000,
				year->s : #-># * 31536000,
				month->s : #-># * 2628000,
				week->s : #-># * 604800,
				hour->s : #-># * 3600,
				tick->s : #-># / 100,
				second->s : #->#
			}
			Comment: "Expresses the value for the duration of periods.";
		}
		Quantity Q_Currency {
			BaseUnit: $;
			Comment: "Expresses monetary values such as costs and revenues in the model.";
		}
		Quantity SI_Length {
			BaseUnit: m;
			Conversions: km->m : #->1000*#;
			Comment: "Expresses the value of a distance.";
		}
	}
	Section Data_Model {
		Comment: "Master data declarations for the vessel scheduling problem: calendars, cargoes, vessels, locations, and routes.";
		Section Calendars {
			Comment: "Calendar definitions and derived date parameters for the planning horizon.";
			StringParameter sp_timeslotFormat {
				Comment: "Format string used to display calendar timeslots, e.g., '2023-01-15'.";
				Definition: "%c%y-%m-%d";
			}
			StringParameter sp_today {
				Comment: "Today's date as a string in YYYY-MM-DD format, set during calendar initialization.";
			}
			Calendar cal_days {
				Index: i_day;
				Unit: day;
				BeginDate: sp_def_beginDate;
				EndDate: sp_def_endDate;
				TimeslotFormat: sp_timeslotFormat;
			}
			ElementParameter ep_startHorizonDate {
				Range: cal_days;
				Comment: "Start of modeling horizon.";
				dex::ColumnName: StartDate;
				dex::Dataset: ImportDataSet;
				dex::TableName: Horizon;
			}
			ElementParameter ep_def_finishHorizonDate {
				Range: cal_days;
				Definition: max( i_act_cargo, ep_maxTimeWindow( i_act_cargo ) + ( p_def_deliveryTimeCargo(i_act_cargo) / 1[day] ) );
				Comment: "Last pickup time of cargos";
			}
			Parameter p_def_noDaysSchedule {
				Unit: day;
				Comment: "Total length of the planning horizon in days, computed as the difference between the last cargo delivery date and the start horizon date.";
				Definition: {
					if ep_def_finishHorizonDate and ep_startHorizonDate then
						( ep_def_finishHorizonDate - ep_startHorizonDate ) + 1[day]
					else
						60[day]
					endif ;
				}
			}
			StringParameter sp_def_beginDate {
				Comment: "Default start date of the cal_days calendar, used as the outer boundary for the calendar definition.";
				Definition: "2023-01-01";
			}
			StringParameter sp_def_endDate {
				Comment: "Default end date of the cal_days calendar, used as the outer boundary for the calendar definition.";
				Definition: "2023-12-31";
			}
			Procedure pr_initCalendar {
				Comment: "Initializes the planning calendar by setting sp_today to the current date and setting ep_startHorizonDate to the first element of cal_days.";
				Body: {
					sp_today := CurrentToString("%c%y-%m-%d");
					!ep_startHorizonDate := StringToElement(cal_days, sp_today, 0);
					ep_startHorizonDate := first( cal_days );
				}
			}
		}
		Section Cargoes {
			Comment: "Master data for cargoes: sets, indices, activation flags, cost parameters, port assignments, and time windows.";
			Set s_cargoes {
				Index: i_cargo_aux;
				Parameter: ep_cargo;
				Comment: "Master set of all cargoes defined in the problem instance.";
			}
			Index i_cargo {
				Range: s_cargoes;
				Comment: "General index over all cargoes in s_cargoes.";
				dex::ColumnName: Cargo;
			}
			Index i_act_cargo {
				Range: s_def_activeCargoes;
				Comment: "Index over active cargoes only (those with bp_activeCargoes = 1).";
				dex::ColumnName: Cargo;
			}
			Index i_act_cargo_aux {
				Range: s_def_activeCargoes;
				Comment: "Auxiliary index over active cargoes, used to copy cargo data across routes.";
			}
			Set s_def_activeCargoes {
				SubsetOf: s_cargoes;
				Comment: "Subset of cargoes that are currently active (bp_activeCargoes = 1) and included in the optimization.";
				Definition: {
					{i_cargo | bp_activeCargoes(i_cargo)}
				}
			}
			Parameter bp_activeCargoes {
				IndexDomain: i_cargo;
				Range: binary;
				InitialData: 1;
				Comment: "Flag indicating whether cargo i_cargo is active (1) and should be included in the optimization, or inactive (0).";
			}
			Parameter p_spotCostVessel {
				IndexDomain: i_cargo;
				Unit: $;
				Comment: "Cost of fulfilling cargo i_cargo using a chartered (spot) vessel instead of an owned vessel.";
				dex::ColumnName: Spot Cost;
				dex::Dataset: ImportDataSet;
				dex::TableName: CargoData;
				webui::AnnotationsIdentifier: ui::sp_def_focusedCargo(i_cargo);
			}
			ElementParameter ep_minTimeWindow {
				IndexDomain: i_cargo;
				Range: cal_days;
				Comment: "Earliest calendar day on which cargo i_cargo can be loaded (start of the pickup time window).";
				dex::ColumnName: Minimum Loading Time;
				dex::Dataset: ImportDataSet;
				dex::TableName: CargoData;
				webui::AnnotationsIdentifier: ui::sp_def_focusedCargo(i_cargo);
			}
			ElementParameter ep_maxTimeWindow {
				IndexDomain: i_cargo;
				Range: cal_days;
				Comment: "Latest calendar day on which cargo i_cargo can be loaded (end of the pickup time window).";
				dex::ColumnName: Maximum Loading Time;
				dex::Dataset: ImportDataSet;
				dex::TableName: CargoData;
				webui::AnnotationsIdentifier: ui::sp_def_focusedCargo(i_cargo);
			}
			ElementParameter ep_loadingPortsCargo {
				IndexDomain: i_cargo;
				Range: s_locations;
				Comment: "Loading (pickup) port for cargo i_cargo.";
				dex::ColumnName: Loading Port;
				dex::Dataset: ImportDataSet;
				dex::TableName: CargoData;
				webui::AnnotationsIdentifier: ui::sp_def_focusedCargo(i_cargo);
			}
			StringParameter sp_loadingPortsCargo {
				IndexDomain: i_cargo;
				Comment: "String representation of the loading port for cargo i_cargo, used as input from the Python bridge before mapping to s_locations elements.";
			}
			ElementParameter ep_deliveringPortsCargo {
				IndexDomain: i_cargo;
				Range: s_locations;
				Comment: "Delivery port for cargo i_cargo.";
				dex::ColumnName: Delevering Port;
				dex::Dataset: ImportDataSet;
				dex::TableName: CargoData;
				webui::AnnotationsIdentifier: ui::sp_def_focusedCargo(i_cargo);
			}
			StringParameter sp_deliveringPortsCargo {
				IndexDomain: i_cargo;
				Comment: "String representation of the delivery port for cargo i_cargo, used as input from the Python bridge before mapping to s_locations elements.";
			}
			Parameter p_def_deliveryTimeCargo {
				IndexDomain: i_cargo;
				Unit: day;
				Comment: "Travel time in days from the loading port to the delivery port of cargo i_cargo, based on the selected distance metric.";
				Definition: {
					p_def_distanceBetweenLocations(
						ep_loadingPortsCargo(i_cargo), 
						ep_deliveringPortsCargo(i_cargo))
				}
			}
			Parameter p_cargoCost {
				IndexDomain: (i_cargo);
				Range: free;
				Unit: $;
				Comment: "Fixed cost associated with transporting cargo i_cargo on a scheduled vessel route.";
				dex::ColumnName: Fixed Cost;
				dex::Dataset: ImportDataSet;
				dex::TableName: CargoData;
				webui::AnnotationsIdentifier: ui::sp_def_focusedCargo(i_cargo);
			}
			Set s_def_loadingPorts {
				SubsetOf: s_locations;
				Index: i_locLoad;
				Comment: "Subset of locations that serve as a loading (pickup) port for at least one cargo.";
				Definition: {
					{i_loc | exists(i_cargo | i_loc = ep_loadingPortsCargo(i_cargo))}
				}
			}
			Set s_def_deleveringPorts {
				SubsetOf: s_locations;
				Index: i_locDeliv;
				Comment: "Subset of locations that serve as a delivery port for at least one cargo.";
				Definition: {
					{i_loc | exists(i_cargo | i_loc = ep_deliveringPortsCargo(i_cargo))}
				}
			}
			Set s_def_vesselOriginPorts {
				SubsetOf: s_locations;
				Index: i_locVess;
				Comment: "Subset of locations that are origin (berth) ports for at least one active vessel.";
				Definition: {
					{i_loc | exists(i_act_vessel | i_loc = ep_originPortOfVessel(i_act_vessel))}
				}
			}
			Parameter p_def_minTimeWindow {
				IndexDomain: i_cargo;
				Unit: day;
				Comment: "Minimum loading time of cargo i_cargo expressed as number of days elapsed since ep_startHorizonDate.";
				Definition: StringToMoment("%c%y-%m-%d", [day], ep_startHorizonDate, ep_minTimeWindow(i_cargo));
			}
			Parameter p_def_maxTimeWindow {
				IndexDomain: i_cargo;
				Unit: day;
				Comment: "Maximum loading time of cargo i_cargo expressed as number of days elapsed since ep_startHorizonDate.";
				Definition: StringToMoment("%c%y-%m-%d", [day], ep_startHorizonDate, ep_maxTimeWindow(i_cargo));
			}
			Parameter p_def_maxDeliveryDate {
				IndexDomain: i_cargo;
				Unit: day;
				Comment: "Latest possible delivery date for cargo i_cargo: maximum pickup time plus the transit time to the delivery port.";
				Definition: {
					p_def_maxTimeWindow(i_cargo) +
					p_def_deliveryTimeCargo(i_cargo)
				}
			}
		}
		Section Vessels {
			Comment: "Master data for vessels: sets, indices, activation flags, speed, costs, and activity type definitions.";
			Parameter p_vesselVelocity {
				Unit: km/hour;
				InitialData: 37.04;
				Comment: "20 knots";
			}
			Set s_vessels {
				Parameter: ep_vessel;
				Comment: "Master set of all vessels defined in the problem instance.";
			}
			Index i_vessel {
				Range: s_vessels;
				Comment: "General index over all vessels in s_vessels.";
				dex::ColumnName: Vessel;
			}
			Set s_def_activeVessels {
				SubsetOf: s_vessels;
				Index: i_act_vessel;
				Comment: "Subset of vessels that are currently active (bp_activeVessels = 1) and included in the optimization.";
				Definition: {
					{i_vessel | bp_activeVessels(i_vessel)}
				}
			}
			Parameter bp_activeVessels {
				IndexDomain: i_vessel;
				Range: binary;
				InitialData: 1;
				Comment: "Flag indicating whether vessel i_vessel is active (1) and available for route assignment, or inactive (0).";
			}
			ElementParameter ep_originPortOfVessel {
				IndexDomain: i_vessel;
				Range: s_locations;
				Comment: "Starting location (berth port) of vessel i_vessel at the beginning of the planning horizon.";
				dex::ColumnName: Port of Origin;
				dex::Dataset: ImportDataSet;
				dex::TableName: VesselData;
			}
			Parameter p_sailingCost {
				IndexDomain: (i_vessel);
				Unit: $/day;
				Comment: {
					"! Fuel usage per day is 63000 gallons = 238000 liter -> 238000/100000 * €601 = 1433"
				}
				dex::ColumnName: Sailing Cost;
				dex::Dataset: ImportDataSet;
				dex::TableName: VesselData;
			}
			Parameter p_def_idleCostVesselNotUsed {
				IndexDomain: i_vessel;
				Unit: $;
				Comment: "Total idle cost penalty for vessel i_vessel if it is not assigned to any route over the full planning horizon.";
				Definition: {
					p_def_noDaysSchedule * 
					p_idleCostLocation( ep_originPortOfVessel( i_vessel ) )
				}
			}
			Set s_def_vesselActivities {
				Index: i_vesselActivities;
				Comment: "Enumeration of all possible activity types a vessel can perform during a route leg.";
				Definition: {
					data { 
						idleNothingToDo,  ! Waiting; no more cargos to be handled for this route.
						idleWaitForCargo, ! Waiting in a port for a Cargo to become available.
						sailingPickup,    ! Sailing towards a pickup point.
						sailingDelivery   ! Sailing towards a delivery point.
					}
				}
				webui::ElementTextIdentifier: sp_vesselActivityPresentation;
			}
			ElementParameter ep_def_vesselIdleWaitCargo {
				Range: s_def_vesselActivities;
				Comment: "Constant element representing the 'idle waiting for cargo' activity type.";
				Definition: 'idleWaitForCargo';
			}
			ElementParameter ep_def_vesselIdleRetired {
				Range: s_def_vesselActivities;
				Comment: "Constant element representing the 'idle with nothing to do' activity type (waiting until end of horizon).";
				Definition: 'idleNothingToDo';
			}
			ElementParameter ep_def_vesselSailingPickup {
				Range: s_def_vesselActivities;
				Comment: "Constant element representing the 'sailing to pickup port' activity type.";
				Definition: 'sailingPickup';
			}
			ElementParameter ep_def_vesselSailingDelivery {
				Range: s_def_vesselActivities;
				Comment: "Constant element representing the 'sailing to delivery port' activity type.";
				Definition: 'sailingDelivery';
			}
			StringParameter sp_vesselActivityPresentation {
				Comment: "Human-readable display text for each vessel activity type, used in WebUI widgets via the ElementTextIdentifier.";

				IndexDomain: i_vesselActivities;
				Definition: {
					data { 
						idleNothingToDo  : "Idle - Waiting for end",  ! Waiting; no more cargos to be handled for this route.
						idleWaitForCargo : "Idle - Waiting for cargo", ! Waiting in a port for a Cargo to become available.
						sailingPickup    : "Sailing to pickup point",    ! Sailing towards a pickup point.
						sailingDelivery  : "Sailing to delivery point"  ! Sailing towards a delivery point.
					}
				}
			}
		}
		Section Locations {
			Comment: "Master data for port locations: sets, indices, activation flags, geographic coordinates, cost parameters, and distance calculations.";
			Set s_locations {
				Parameter: ep_location;
				Comment: "Master set of all port locations defined in the problem instance.";
			}
			Parameter p_noLocations {
				Comment: "Total number of locations in s_locations.";
				Definition: card(s_locations);
			}
			Index i_loc {
				Range: s_locations;
				Comment: "General index over all locations in s_locations.";
				dex::ColumnName: Location;
			}
			Index i_loc_from {
				Range: s_locations;
				Comment: "Origin location index used in distance matrices.";
				dex::ColumnName: Location (From);
			}
			Index i_loc_to {
				Range: s_locations;
				Comment: "Destination location index used in distance matrices.";
				dex::ColumnName: Location (To);
			}
			Set s_def_activeLocations {
				SubsetOf: s_locations;
				Index: i_act_loc;
				Comment: "Subset of locations that are currently active (bp_activeLocations = 1) and included in the model.";
				Definition: {
					{i_loc | bp_activeLocations(i_loc)}
				}
			}
			Parameter bp_activeLocations {
				IndexDomain: i_loc;
				Range: binary;
				InitialData: 1;
				Comment: "Flag indicating whether location i_loc is active (1) and available for routing, or inactive (0).";
			}
			Parameter p_latitude {
				IndexDomain: i_loc;
				Comment: "Geographic latitude (in decimal degrees) of location i_loc, used in Haversine distance calculations.";
				dex::ColumnName: Latitude;
				dex::Dataset: ImportDataSet;
				dex::TableName: LocationData;
			}
			Parameter p_longitude {
				IndexDomain: i_loc;
				Comment: "Geographic longitude (in decimal degrees) of location i_loc, used in Haversine distance calculations.";
				dex::ColumnName: Longitude;
				dex::Dataset: ImportDataSet;
				dex::TableName: LocationData;
			}
			Parameter p_idleCostLocation {
				IndexDomain: i_loc;
				Unit: $/day;
				dex::ColumnName: Idle Cost;
				dex::Dataset: ImportDataSet;
				dex::TableName: LocationData;
				webui::AnnotationsIdentifier: ui::sp_def_focusedLocationFrom;
			}
			Parameter p_adminCostAtLocation {
				IndexDomain: (i_loc);
				Unit: $;
				Comment: "Administrative cost incurred each time a vessel visits location i_loc.";
				dex::ColumnName: Admin Cost;
				dex::Dataset: ImportDataSet;
				dex::TableName: LocationData;
				webui::AnnotationsIdentifier: ui::sp_def_focusedLocationFrom;
			}
			Parameter p_loadingCostAtLocation {
				IndexDomain: (i_loc);
				Unit: $;
				Comment: "Loading cost incurred when a vessel picks up a cargo at location i_loc.";
				dex::ColumnName: Loading Cost;
				dex::Dataset: ImportDataSet;
				dex::TableName: LocationData;
				webui::AnnotationsIdentifier: ui::sp_def_focusedLocationFrom;
			}
			Parameter p_def_haversineDistance {
				IndexDomain: (i_loc_from,i_loc_to)| i_loc_from <> i_loc_to;
				Unit: km;
				Comment: "Great-circle (Haversine) distance in km between i_loc_from and i_loc_to, calculated from their latitude/longitude coordinates.";
				Definition: {
					((6371.0[km])
					    * arccos(
					        cos(radians(90 - P_latitude(i_loc_from)))
					        * cos(radians(90 - P_latitude(i_loc_to)))
					        +
					        sin(radians(90 - P_latitude(i_loc_from)))
					        * sin(radians(90 - P_latitude(i_loc_to)))
					        * cos(radians(p_longitude(i_loc_from) - p_longitude(i_loc_to)))))
				}
			}
			Parameter p_def_harvesineDistanceBetweenLocations {
				IndexDomain: (i_loc_from,i_loc_to)| i_loc_from <> i_loc_to;
				Unit: day;
				Comment: "Travel time in days between i_loc_from and i_loc_to based on the Haversine (great-circle) distance divided by vessel velocity.";
				Definition: {
					p_def_haversineDistance(i_loc_from, i_loc_to)
					/$ p_vesselVelocity
				}
			}
			Parameter p_def_searouteDistanceBetweenLocations {
				IndexDomain: (i_loc_from,i_loc_to)| i_loc_from <> i_loc_to;
				Unit: day;
				Comment: "Travel time in days between i_loc_from and i_loc_to based on the sea-route distance (from the pre-computed Parquet matrix) divided by vessel velocity.";
				Definition: {
					( p_distance_searoute(i_loc_from, i_loc_to) + p_distance_searoute(i_loc_to, i_loc_from) )[km] 
					/$ p_vesselVelocity
				}
			}
			Parameter p_def_distanceBetweenLocations {
				IndexDomain: (i_loc_from, i_loc_to);
				Unit: day;
				Comment: "Selected travel time in days between i_loc_from and i_loc_to: uses sea-route distances when bp_use_searoute_distances is 1, otherwise uses Haversine distances; rounded to whole days.";
				Definition: {
					if bp_use_searoute_distances then
						round(p_def_searouteDistanceBetweenLocations(i_loc_from, i_loc_to),0)
					else
						round(p_def_harvesineDistanceBetweenLocations(i_loc_from, i_loc_to),0)
					endif
				}
			}
		}
		Section Routes {
			Comment: "Declarations for feasible route generation and route cost calculations, including sets, indices, activity data, and cost parameters.";
			Set s_routeCalculationImplementations {
				Comment: "Set of available route calculation implementations: 'scalar' (sequential) and 'parallelized' (batch).";
				Definition: data { scalar, parallelized };
			}
			ElementParameter ep_selectedRouteCalculationImplementation {
				Range: s_routeCalculationImplementations;
				InitialData: 'parallelized';
				Comment: "Currently selected route calculation implementation to use when generating all feasible routes.";
				dex::ColumnName: routeCalculationImplementation;
				dex::Dataset: ImportDataSet;
				dex::TableName: Horizon;
			}
			Set s_calc_feasibleRoutes {
				Index: i_route;
				Parameter: ep_route;
				Comment: "Set of all feasible routes generated for the active vessels and cargoes. Each route represents a sequence of cargo pickups and deliveries for one vessel.";
			}
			Parameter p_noFeasibleRoutes {
				Comment: "Total number of feasible routes currently generated in s_calc_feasibleRoutes.";
				Definition: card( s_calc_feasibleRoutes );
			}
			Index i_leg {
				Range: s_calc_legs;
				Comment: "Index over the legs (activity steps) of a route, ranging over s_calc_legs.";
				dex::ColumnName: Leg;
			}
			Index i_leg_aux {
				Range: s_calc_legs;
				Comment: "Auxiliary leg index used in route building logic when iterating over legs independently of i_leg.";
			}
			Set s_calc_legs {
				SubsetOf: Integers;
				Property: ElementsAreLabels;
				Comment: "Set of integer leg numbers (1..200) used as position indices for vessel activity legs within a route.";
				Definition: {
					{ 1 .. 200 }
				}
			}
			Index i_used_route {
				Range: s_calc_usedRoutes;
				Comment: "Index over the routes that are actually used in the optimal solution (subset of s_calc_feasibleRoutes).";
				dex::ColumnName: Route;
			}
			Set s_calc_usedRoutes {
				SubsetOf: s_calc_feasibleRoutes;
				Comment: "The routes in the solution of the last solved mm::mp_vesselScheduling.";
			}
			Set s_calc_cargosHandled {
				IndexDomain: i_route;
				SubsetOf: s_cargoes;
				OrderBy: user;
				Comment: "For each route i_route, the set of cargoes that are picked up and delivered on that route.";
			}
			Set s_temp_routeWorkingList {
				SubsetOf: s_calc_feasibleRoutes;
				Index: i_workRoute;
				Parameter: ep_workRoute;
				OrderBy: user;
				Comment: {
					"This set of route functions as a FIFO list;
					new routes are appended to the end, and processed from the
					beginning."
				}
			}
			ElementParameter ep_temp_lastLocation {
				IndexDomain: i_route;
				Range: s_locations;
				Comment: "Temporary: the last location reached by route i_route after processing all cargoes added so far, used during route generation.";
			}
			ElementParameter ep_temp_nextSailingDay {
				IndexDomain: i_route;
				Range: cal_days;
				Comment: "Temporary: the earliest day a vessel on route i_route is available to depart after delivering the last cargo added so far.";
			}
			ElementParameter ep_calc_pickupDate {
				IndexDomain: (i_route,i_cargo);
				Range: cal_days;
				Comment: "to be used for p_calc_loadingTimeCargoRoute.";
			}
			ElementParameter ep_calc_deliveryDate {
				IndexDomain: (i_route,i_cargo);
				Range: cal_days;
				Comment: "Computed delivery date of cargo i_cargo on route i_route, based on pickup date plus transit time.";
			}
			ElementParameter ep_calc_routeVessel {
				IndexDomain: i_route;
				Range: s_vessels;
				Comment: "The vessel that is assigned to route i_route during route generation.";
			}
			ElementParameter ep_calc_routeLastLeg {
				IndexDomain: i_route;
				Range: s_calc_legs;
				Comment: "Index of the last active leg of route i_route in s_calc_legs.";
			}
			ElementParameter ep_calc_vesselActivityType {
				IndexDomain: (i_route, i_leg);
				Range: s_def_vesselActivities;
				Comment: "Activity type performed by the vessel at leg i_leg of route i_route (e.g., sailingPickup, sailingDelivery, idleWaitForCargo).";
				webui::FlagsIdentifier: ui::sp_def_readOnly;
			}
			ElementParameter ep_calc_vesselActivityCargo {
				IndexDomain: (i_route, i_leg);
				Range: s_cargoes;
				Comment: "The cargo associated with the vessel activity at leg i_leg of route i_route.";
				webui::FlagsIdentifier: ui::sp_def_readOnly;
			}
			ElementParameter ep_calc_vesselActivityLocation {
				IndexDomain: (i_route,i_leg);
				Range: s_locations;
				Comment: {
					"For activities ep_vesselIdleWaitCargo and ep_vesselIdleRetired
					the location where the vessel is at.
					For activities ep_vesselSailingPickup  and ep_vesselSailingDelivery  the
					location where the vessel is sailing towards."
				}
				webui::FlagsIdentifier: ui::sp_def_readOnly;
			}
			ElementParameter ep_calc_vesselActivityFirst {
				IndexDomain: (i_route,i_leg);
				Range: cal_days;
				Comment: "First day of this vessel activity.";
				webui::FlagsIdentifier: ui::sp_def_readOnly;
			}
			ElementParameter ep_calc_vesselActivityLast {
				IndexDomain: (i_route,i_leg);
				Range: cal_days;
				Comment: "Last day of the vessel activity at leg i_leg of route i_route.";
				webui::FlagsIdentifier: ui::sp_def_readOnly;
			}
			Parameter p_calc_arcsPerRoute {
				IndexDomain: (i_route,i_loc_from,i_loc_to);
				Range: binary;
				Comment: "1 if route i_route includes a sailing leg from i_loc_from to i_loc_to; used to draw arcs on the map.";
			}
			Parameter p_def_vesselActivityLength {
				IndexDomain: (i_route,i_leg) | ep_calc_vesselActivityLast(i_route, i_leg);
				Unit: day;
				Comment: "Duration in days of the vessel activity at leg i_leg of route i_route (last day minus first day).";
				Definition: ((ep_calc_vesselActivityLast(i_route, i_leg) - ep_calc_vesselActivityFirst(i_route, i_leg)));
			}
			Parameter p_def_routeSailingDays {
				IndexDomain: i_route;
				Unit: day;
				Comment: "Total number of sailing days for route i_route, summed over all pickup and delivery sailing legs.";
				Definition: {
					sum(i_leg | 
					        ep_calc_vesselActivityType(i_route, i_leg) = ep_def_vesselSailingPickup 
					        or ep_calc_vesselActivityType(i_route, i_leg) = ep_def_vesselSailingDelivery,
						p_def_vesselActivityLength(i_route, i_leg))
				}
			}
			Parameter p_def_routeIdleDays {
				IndexDomain: i_route;
				Unit: day;
				Comment: "Total number of idle days for route i_route, summed over all waiting-for-cargo and idle-retired legs.";
				Definition: {
					sum( i_leg | 
						ep_calc_vesselActivityType(i_route, i_leg) = ep_def_vesselIdleWaitCargo or
						ep_calc_vesselActivityType(i_route, i_leg) = ep_def_vesselIdleRetired ,
						p_def_vesselActivityLength(i_route, i_leg) )
				}
			}
			Parameter p_def_routeSailingCost {
				IndexDomain: i_route;
				Unit: $;
				Comment: "Total sailing cost for route i_route: sailing days multiplied by the per-day sailing cost of the vessel assigned to the route.";
				Definition: {
					p_def_routeSailingDays(i_route) 
					* p_sailingCost(ep_calc_routeVessel(i_route))
				}
			}
			Parameter p_def_visitingLocationCost {
				IndexDomain: i_route;
				Unit: $;
				Definition: {
					sum(i_leg | 
					        ep_calc_vesselActivityType(i_route, i_leg) = ep_def_vesselSailingPickup  
					        or ep_calc_vesselActivityType(i_route, i_leg) = ep_def_vesselSailingDelivery,
						p_adminCostAtLocation(ep_calc_vesselActivityLocation(i_route, i_leg)))
					+
					
					sum(i_leg | 
						    ep_calc_vesselActivityType(i_route, i_leg) = ep_def_vesselSailingPickup,
						p_loadingCostAtLocation(ep_calc_vesselActivityLocation(i_route, i_leg)))
				}
				Comment: {
					"The admin costs for visiting each location, and 
					the loading costs for visiting pickup locations."
				}
			}
			Parameter p_def_cargoCost {
				IndexDomain: i_route;
				Unit: $;
				Comment: "Total fixed cargo cost for route i_route: the sum of p_cargoCost for all cargoes handled on the route.";
				Definition: {
					sum(i_cargo |
					        i_cargo in s_calc_cargosHandled(i_route),
						p_cargoCost(i_cargo))
				}
			}
			Parameter p_def_routeIdleCost {
				IndexDomain: i_route;
				Unit: $;
				Comment: "Total idle cost for route i_route: sum of idle duration at each idle leg multiplied by the idle cost rate at the vessel's location.";
				Definition: {
					sum(i_leg | 
					        ep_calc_vesselActivityType(i_route, i_leg) = ep_def_vesselIdleWaitCargo
					        or ep_calc_vesselActivityType(i_route, i_leg) = ep_def_vesselIdleRetired,
						p_def_vesselActivityLength(i_route, i_leg)
						* p_idleCostLocation(ep_calc_vesselActivityLocation(i_route, i_leg)))
				}
			}
			Parameter p_def_routeCosts {
				IndexDomain: i_route;
				Unit: $;
				Comment: "Total cost for route i_route: sailing cost + location visiting cost + cargo cost + idle cost.";
				Definition: {
					p_def_routeSailingCost(i_route) 
					+ p_def_visitingLocationCost(i_route) 
					+ p_def_cargoCost(i_route) 
					+ p_def_routeIdleCost(i_route)
				}
			}
			Parameter p_def_loadingTimeCargoRoute {
				IndexDomain: (i_act_cargo,i_route) | ep_calc_pickupDate(i_route, i_act_cargo);
				Unit: day;
				Definition: ep_calc_pickupDate(i_route, i_act_cargo) - ep_startHorizonDate;
				Comment: "the moment the cargo is loaded upon the vessel when it follows i_route.";
				webui::FlagsIdentifier: ui::sp_def_readOnly;
			}
			Parameter p_def_cargoesOnRoute {
				IndexDomain: (i_route,i_cargo);
				Range: nonnegative;
				Comment: "1 if cargo i_cargo is handled on route i_route; 0 otherwise. Used as a coefficient in the cargo assignment constraint.";
				Definition: 1 $ (i_cargo in s_calc_cargosHandled(i_route));
			}
			Parameter bp_def_cargoesOnRoute {
				IndexDomain: (i_route,i_act_cargo);
				Range: binary;
				Comment: "Binary version of p_def_cargoesOnRoute restricted to active cargoes.";
				Definition: 1 $ p_def_cargoesOnRoute(i_route,i_act_cargo);
			}
			Parameter p_def_deleveringTimeCargoRoute {
				IndexDomain: (i_act_cargo,i_route) | p_def_cargoesOnRoute(i_route,i_act_cargo);
				Unit: day;
				Comment: "Day (offset from ep_startHorizonDate) on which cargo i_act_cargo is delivered when following route i_route.";
				Definition: {
					(p_def_loadingTimeCargoRoute(i_act_cargo, i_route) 
					+ p_def_distanceBetweenLocations(ep_loadingPortsCargo(i_act_cargo), ep_deliveringPortsCargo(i_act_cargo)))
				}
				webui::FlagsIdentifier: ui::sp_def_readOnly;
			}
			Parameter bp_def_deliveringLocationsOnRoute {
				IndexDomain: (i_route,i_loc);
				Range: binary;
				Comment: "1 if location i_loc is visited as a delivery destination on route i_route; used for map visualization of used routes.";
				Definition: {
					exists(i_leg | 
					    ep_calc_vesselActivityLocation(i_route, i_leg) = i_loc
					    and ep_calc_vesselActivityType(i_route, i_leg) = 'sailingDelivery')
				}
			}
			Parameter bp_def_loadingLocationsOnRoute {
				IndexDomain: (i_used_route,i_loc);
				Range: binary;
				Comment: "1 if location i_loc is visited as a loading point (pickup or origin) on used route i_used_route; used for map visualization.";
				Definition: {
					exists(i_leg | 
					    (ep_calc_vesselActivityLocation(i_used_route, i_leg) = i_loc
					    and ep_calc_vesselActivityType(i_used_route, i_leg) = 'sailingPickup'))
					
					or (ep_originPortOfVessel(ep_calc_routeVessel(i_used_route)) = i_loc
					    and i_loc = ep_calc_vesselActivityLocation(i_used_route, '1'))
				}
			}
			Procedure pr_calculateRoutesAndCost {
				Arguments: (ep_routeCalculationImplementation);
				Comment: "Generates all feasible vessel routes using the selected implementation (scalar or parallelized), computes vessel activity legs, and builds arc data for map visualization.";
				Body: {
					! Determine horizon start (is read in via Excel inp).
					! Determine horizon length (is end - start) whereby
					! horizon end is defined as the last day for delivery of any cargo.
					
					! Empty route sets, and dependent identifiers.
					pr_initRoutes(); 
					
					! For each vessel, initialize to the empty route.
					pr_initRouteSetWithVesselsOnly();
					
					if ep_routeCalculationImplementation = 'parallelized' then
						pr_processRouteListEx();
					else
						pr_processRouteList();
					endif ;
					
					block ! create arcs for map
						empty p_calc_arcsPerRoute;
						p_calc_arcsPerRoute(i_route, ep_originPortOfVessel(ep_calc_routeVessel(i_route)), ep_calc_vesselActivityLocation(i_route, '1')) |
							(ep_originPortOfVessel(ep_calc_routeVessel(i_route)) <> ep_calc_vesselActivityLocation(i_route, '1'))
						:=  1;
						p_calc_arcsPerRoute(i_route, ep_calc_vesselActivityLocation(i_route, i_leg - 1), ep_calc_vesselActivityLocation(i_route, i_leg))|
							ep_calc_vesselActivityLocation(i_route, i_leg - 1) <> ep_calc_vesselActivityLocation(i_route, i_leg)
						:= 1;
					endblock ;
				}
				ElementParameter ep_routeCalculationImplementation {
					Range: s_routeCalculationImplementations;
					Property: Input;
				}
			}
			Procedure pr_initRoutes {
				Body: {
					empty s_calc_feasibleRoutes  ; ! Will also empty all identifiers declared over s_calc_routes.
					cleandependents s_calc_feasibleRoutes ; ! Will also empty the element space for s_calc_feasibleRoutes.
				}
				Comment: "Empty the route set, and its element space.";
			}
			Procedure pr_initRouteSetWithVesselsOnly {
				Comment: "Initializes s_calc_feasibleRoutes with one empty route per active vessel, setting the starting location and date for each vessel, and populating the working list.";
				Body: {
					ep_loc_leg := first(s_calc_legs);
					
					! For each Vessel, a feasible route is to leave it in its berth.
					for i_act_vessel do
					
						! Create empty route for this vessel.
						SetElementAdd(s_calc_feasibleRoutes, ep_loc_newRoute, FormatString("%e", i_act_vessel));
					
						! Append the new route to the working list.
						s_temp_routeWorkingList += ep_loc_newRoute;
					
						! initialize globals for each new route.
						s_calc_cargosHandled(ep_loc_newRoute) := {};
					
						ep_temp_nextSailingDay(ep_loc_newRoute) := ep_startHorizonDate;
						ep_temp_lastLocation(ep_loc_newRoute) := ep_originPortOfVessel(i_act_vessel);
					
						ep_calc_routeVessel(ep_loc_newRoute) := i_act_vessel;
						ep_calc_routeLastLeg(ep_loc_newRoute) := ep_loc_leg;
						ep_calc_vesselActivityType(ep_loc_newRoute, ep_loc_leg) := ep_def_vesselIdleRetired;
						ep_calc_vesselActivityLocation(ep_loc_newRoute, ep_loc_leg) := ep_originPortOfVessel(i_act_vessel);
						ep_calc_vesselActivityFirst(ep_loc_newRoute, ep_loc_leg) := ep_startHorizonDate;
						ep_calc_vesselActivityLast(ep_loc_newRoute, ep_loc_leg) := ep_def_finishHorizonDate;
					endfor;
				}
				ElementParameter ep_loc_newRoute {
					Range: s_calc_feasibleRoutes;
				}
				ElementParameter ep_loc_leg {
					Range: s_calc_legs;
				}
			}
			Procedure pr_processRouteList {
				Comment: "Scalar (sequential) route generation: iterates over the working list one route at a time, calling pr_processSingleRoute for each to expand the feasible route set.";
				Body: {
					while card(s_temp_routeWorkingList) do
						ep_loc_workingRoute := first(s_temp_routeWorkingList);
						s_temp_routeWorkingList -= ep_loc_workingRoute ;
						pr_processSingleRoute(ep_loc_workingRoute);
					endwhile;
				}
				ElementParameter ep_loc_workingRoute {
					Range: s_calc_feasibleRoutes;
				}
			}
			Procedure pr_processSingleRoute {
				Arguments: (ep_in_workingRoute);
				Comment: "For a given working route ep_in_workingRoute, computes feasibility of adding each active cargo and creates new child routes for all feasible cargo additions, appending them to the working list.";
				Body: {
					! Earliest possible arrival:
					ep_loc_arrivalDay(i_act_cargo) 
					:=  ep_temp_nextSailingDay(ep_in_workingRoute) 
					    + p_def_distanceBetweenLocations(ep_temp_lastLocation(ep_in_workingRoute), ep_loadingPortsCargo(i_act_cargo))/1[day];
					
					! Earliest possible pickup - both vessel and cargo need to be present.
					ep_loc_pickupDay(i_act_cargo) := max(ep_loc_arrivalDay(i_act_cargo), ep_minTimeWindow(i_act_cargo));
					
					! Next sailing day - after pickup the sailing to the delivery:
					ep_loc_nextSailingDay(i_act_cargo) 
					:=  ep_loc_pickupDay(i_act_cargo) 
					    + p_def_distanceBetweenLocations(ep_loadingPortsCargo(i_act_cargo), ep_deliveringPortsCargo(i_act_cargo))/1[day];
					
					for i_act_cargo | 
					        (not (i_act_cargo in s_calc_cargosHandled(ep_in_workingRoute))) 
					        and (ep_loc_pickupDay(i_act_cargo) <= ep_maxTimeWindow(i_act_cargo)) 
					        and (ep_loc_nextSailingDay(i_act_cargo) <= ep_def_finishHorizonDate) do 
					
						! The name of the new route is the same as the old route, with the name of the cargo appended.
						sp_loc_newRoute := FormatString("%e_%e", ep_in_workingRoute, i_act_cargo);
					
						! Append this route to the collection of all routes, and to the working list.
						SetElementAdd(s_calc_feasibleRoutes, ep_loc_newRoute, sp_loc_newRoute);
						s_temp_routeWorkingList += ep_loc_newRoute;
					
						! Work the globals for this new route; also copy a lot of data from the parent route.
						s_calc_cargosHandled(ep_loc_newRoute) := s_calc_cargosHandled(ep_in_workingRoute);
						s_calc_cargosHandled(ep_loc_newRoute) += i_act_cargo;
						ep_temp_nextSailingDay(ep_loc_newRoute) := ep_loc_nextSailingDay(i_act_cargo);
						ep_temp_lastLocation(ep_loc_newRoute) := ep_deliveringPortsCargo(i_act_cargo);
						ep_calc_routeVessel(ep_loc_newRoute) := ep_calc_routeVessel(ep_in_workingRoute);
						ep_calc_pickupDate(ep_loc_newRoute, i_act_cargo_aux) := ep_calc_pickupDate(ep_in_workingRoute, i_act_cargo_aux);
						ep_calc_pickupDate(ep_loc_newRoute, i_act_cargo) := ep_loc_pickupDay(i_act_cargo);
					
						! First copy legs from working route to new route.
						ep_calc_routeLastLeg(ep_loc_newRoute) := ep_calc_routeLastLeg(ep_in_workingRoute);
						ep_calc_vesselActivityType(ep_loc_newRoute, i_leg) := ep_calc_vesselActivityType(ep_in_workingRoute, i_leg);
						ep_calc_vesselActivityCargo(ep_loc_newRoute, i_leg) := ep_calc_vesselActivityCargo(ep_in_workingRoute, i_leg);
						ep_calc_vesselActivityLocation(ep_loc_newRoute, i_leg) := ep_calc_vesselActivityLocation(ep_in_workingRoute, i_leg);
						ep_calc_vesselActivityFirst(ep_loc_newRoute, i_leg) := ep_calc_vesselActivityFirst(ep_in_workingRoute, i_leg);
						ep_calc_vesselActivityLast(ep_loc_newRoute, i_leg) := ep_calc_vesselActivityLast(ep_in_workingRoute, i_leg);
					
						! Second, append the legs for handling i_act_cargo:
						! - sailing towards pickup location, 
						! - perhaps waiting for the cargo to become available, 
						! - sailing towards delivery location.
						ep_loc_lastLeg := ep_calc_routeLastLeg(ep_loc_newRoute);
						if ep_calc_vesselActivityType(ep_loc_newRoute, ep_loc_lastLeg) <> ep_def_vesselIdleRetired then
							raise warning 
								FormatString("internal error, each route should have a last leg for awaiting the end of the horizon. ep_loc_newRoute = %e, ep_loc_lastLeg = %e", 
									ep_loc_newRoute, ep_loc_lastLeg) ;
						endif;
					
						! last leg (idle-retired) will be replaced by sailing to pickup for i_act_cargo.
						!display ep_in_workingRoute, ep_temp_lastLocation(ep_in_workingRoute), ep_loadingPortsCargo(i_act_cargo);
						if ep_temp_lastLocation(ep_in_workingRoute) <> ep_loadingPortsCargo(i_act_cargo)  then
							if ep_calc_vesselActivityType( ep_loc_newRoute, ep_loc_lastLeg ) <> ep_def_vesselIdleRetired then
								 ep_loc_lastLeg += 1;
							endif ;
							ep_loc_legSailingPickup := ep_loc_lastLeg ;
							ep_calc_vesselActivityType(     ep_loc_newRoute, ep_loc_legSailingPickup ) := ep_def_vesselSailingPickup ;
							ep_calc_vesselActivityCargo(    ep_loc_newRoute, ep_loc_legSailingPickup ) := i_act_cargo ;
							ep_calc_vesselActivityLocation( ep_loc_newRoute, ep_loc_legSailingPickup ) := ep_loadingPortsCargo(i_act_cargo) ;
							ep_calc_vesselActivityFirst(    ep_loc_newRoute, ep_loc_legSailingPickup ) := ep_calc_vesselActivityFirst( ep_loc_newRoute, ep_loc_legSailingPickup ) ; ! so no change.
							ep_calc_vesselActivityLast(     ep_loc_newRoute, ep_loc_legSailingPickup ) := ep_loc_arrivalDay( i_act_cargo ) ;
						endif ;
					
						! - perhaps waiting for the cargo to become available, 
						if ep_loc_arrivalDay(i_act_cargo) < ep_minTimeWindow(i_act_cargo) then
							! need to wait for the cargo to become available in the pickup port.
							if ep_calc_vesselActivityType(ep_loc_newRoute, ep_loc_lastLeg) <> ep_def_vesselIdleRetired then
								ep_loc_lastLeg += 1;
							endif;
							ep_loc_legWaitingCargo := ep_loc_lastLeg;
							ep_calc_vesselActivityType(     ep_loc_newRoute, ep_loc_legWaitingCargo ) := ep_def_vesselIdleWaitCargo;
							ep_calc_vesselActivityCargo(    ep_loc_newRoute, ep_loc_legWaitingCargo ) := i_act_cargo ;
							ep_calc_vesselActivityLocation( ep_loc_newRoute, ep_loc_legWaitingCargo ) := ep_loadingPortsCargo(i_act_cargo);
							ep_calc_vesselActivityFirst(    ep_loc_newRoute, ep_loc_legWaitingCargo ) := ep_loc_arrivalDay(i_act_cargo); 
							ep_calc_vesselActivityLast(     ep_loc_newRoute, ep_loc_legWaitingCargo ) := ep_minTimeWindow(i_act_cargo);
						endif ;
					
						! - sailing towards delivery location.
						ep_loc_lastLeg += 1;
						ep_loc_legSailingDelivery := ep_loc_lastLeg;
						ep_calc_vesselActivityType(     ep_loc_newRoute, ep_loc_legSailingDelivery ) := ep_def_vesselSailingDelivery;
						ep_calc_vesselActivityCargo(    ep_loc_newRoute, ep_loc_legSailingDelivery ) := i_act_cargo ;
						ep_calc_vesselActivityLocation( ep_loc_newRoute, ep_loc_legSailingDelivery ) := ep_deliveringPortsCargo(i_act_cargo);
						ep_calc_vesselActivityFirst(    ep_loc_newRoute, ep_loc_legSailingDelivery ) := ep_loc_pickupDay(i_act_cargo); 
						ep_calc_vesselActivityLast(     ep_loc_newRoute, ep_loc_legSailingDelivery ) := ep_loc_nextSailingDay(i_act_cargo);
					
						! - Always reserving a leg to wait till end of horizon.
						ep_loc_lastLeg += 1;
						ep_loc_legIdleRetire := ep_loc_lastLeg;
						ep_calc_vesselActivityType(     ep_loc_newRoute, ep_loc_legIdleRetire ) := ep_def_vesselIdleRetired;
						ep_calc_vesselActivityCargo(    ep_loc_newRoute, ep_loc_legIdleRetire ) := i_act_cargo ;
						ep_calc_vesselActivityLocation( ep_loc_newRoute, ep_loc_legIdleRetire ) := ep_deliveringPortsCargo(i_act_cargo);
						ep_calc_vesselActivityFirst(    ep_loc_newRoute, ep_loc_legIdleRetire ) := ep_loc_nextSailingDay(i_act_cargo); 
						ep_calc_vesselActivityLast(     ep_loc_newRoute, ep_loc_legIdleRetire ) := ep_def_finishHorizonDate;
					
						! - Finishing up admin.
						ep_calc_routeLastLeg(ep_loc_newRoute) := ep_loc_lastLeg;
					
					endfor;
				}
				ElementParameter ep_in_workingRoute {
					Range: s_calc_feasibleRoutes;
					Property: Input;
				}
				ElementParameter ep_loc_arrivalDay {
					IndexDomain: i_cargo;
					Range: cal_days;
				}
				ElementParameter ep_loc_pickupDay {
					IndexDomain: i_cargo;
					Range: cal_days;
				}
				ElementParameter ep_loc_nextSailingDay {
					IndexDomain: i_cargo;
					Range: cal_days;
				}
				StringParameter sp_loc_newRoute;
				ElementParameter ep_loc_newRoute {
					Range: s_calc_feasibleRoutes;
				}
				ElementParameter ep_loc_lastLeg {
					Range: s_calc_legs;
				}
				ElementParameter ep_loc_legSailingPickup {
					Range: s_calc_legs;
				}
				ElementParameter ep_loc_legWaitingCargo {
					Range: s_calc_legs;
				}
				ElementParameter ep_loc_legSailingDelivery {
					Range: s_calc_legs;
				}
				ElementParameter ep_loc_legIdleRetire {
					Range: s_calc_legs;
				}
			}
			Procedure pr_processRouteListEx {
				Comment: "Parallelized (batch) route generation: processes all routes in the working list simultaneously per iteration, computing feasibility and creating child routes in bulk using indexed assignments for performance.";
				Body: {
						_ep_tmp_vesselActivityType(     i_route, i_leg ) := ep_calc_vesselActivityType(     i_route, i_leg );
						_ep_tmp_vesselActivityCargo(    i_route, i_leg ) := ep_calc_vesselActivityCargo(    i_route, i_leg );
						_ep_tmp_vesselActivityLocation( i_route, i_leg ) := ep_calc_vesselActivityLocation( i_route, i_leg );
						_ep_tmp_vesselActivityFirst(    i_route, i_leg ) := ep_calc_vesselActivityFirst(    i_route, i_leg );
						_ep_tmp_vesselActivityLast(     i_route, i_leg ) := ep_calc_vesselActivityLast(     i_route, i_leg );
					
					
					_s_inputList := s_temp_routeWorkingList ;
					s_temp_routeWorkingList := {};
					_s_processedRoutes := {};
					while card( _s_inputList ) do
					
						! Earliest possible arrival:
						_ep_loc_arrivalDay( _i_inputRoute, i_act_cargo ) := 
							ep_temp_nextSailingDay(_i_inputRoute) + 
					    		+p_def_distanceBetweenLocations(ep_temp_lastLocation(_i_inputRoute), 
					    			ep_loadingPortsCargo(i_act_cargo))/1[day];
					
						! Earliest possible pickup - both vessel and cargo need to be present.
						_ep_loc_pickupDay(_i_inputRoute, i_act_cargo) := 
							max(_ep_loc_arrivalDay(_i_inputRoute,i_act_cargo), 
								ep_minTimeWindow(i_act_cargo));
					
						! Next sailing day - after pickup the sailing to the delivery:
						_ep_loc_nextSailingDay(_i_inputRoute, i_act_cargo) := 
							_ep_loc_pickupDay(_i_inputRoute, i_act_cargo) 
							+ p_def_distanceBetweenLocations(ep_loadingPortsCargo(i_act_cargo), 
								ep_deliveringPortsCargo(i_act_cargo))/1[day];
					
						! Determine, for each (input) route, the collection of potential next locations.
						_s_next_potential_cargos( _i_inputRoute ) := { i_act_cargo |
							( not ( i_act_cargo in s_calc_cargosHandled( _i_inputRoute ) )                     ) and     ! Do not visit the same location twice.
							( _ep_loc_pickupDay( _i_inputRoute, i_act_cargo ) <= ep_maxTimeWindow(i_act_cargo) ) and     ! Be on time
							( _ep_loc_nextSailingDay(_i_inputRoute, i_act_cargo) <= ep_def_finishHorizonDate   )     } ; ! Don't deliver outside horizon.
					
						! Create the new routes.
						_ep_next_route( _i_inputRoute, _i_next_cargo ) | _i_next_cargo in _s_next_potential_cargos( _i_inputRoute ) :=
							StringToElement( s_calc_feasibleRoutes, formatString( "%e_%e", _i_inputRoute, _i_next_cargo ), create: 1);
						_ep_parent_route( _ep_next_route( _i_inputRoute, _i_next_cargo ) ) := _i_inputRoute ;
						_ep_last_cargo(   _ep_next_route( _i_inputRoute, _i_next_cargo ) ) := _i_next_cargo ;
					
						! Determine the collection of routes, for which route data need to be computed next.
						_s_processedRoutes += _s_inputList ;
						s_temp_routeWorkingList := s_calc_feasibleRoutes - _s_processedRoutes ;
					
						! Work the globals for this new route; also copy a lot of data from the parent route.
						s_calc_cargosHandled(i_workRoute) := s_calc_cargosHandled(_ep_parent_route(i_workRoute)) + _ep_last_cargo( i_workRoute );
						ep_temp_nextSailingDay( i_workRoute ) := _ep_loc_nextSailingDay( _ep_parent_route(i_workRoute), _ep_last_cargo( i_workRoute ) );
						ep_temp_lastLocation( i_workRoute ) := ep_deliveringPortsCargo( _ep_last_cargo( i_workRoute ) );
						ep_calc_routeVessel(i_workRoute) := ep_calc_routeVessel(_ep_parent_route(i_workRoute));
						_ep_tmp_pickupDate( i_route, i_act_cargo_aux ) := ep_calc_pickupDate(i_route, i_act_cargo_aux);
						ep_calc_pickupDate(i_workRoute, i_act_cargo_aux) := _ep_tmp_pickupDate(_ep_parent_route(i_workRoute), i_act_cargo_aux);
						ep_calc_pickupDate(i_workRoute, _ep_last_cargo( i_workRoute )) := _ep_loc_pickupDay(_ep_parent_route(i_workRoute),  _ep_last_cargo( i_workRoute ));
					
						! First copy legs from working route to new route.
						ep_calc_routeLastLeg(i_workRoute) := ep_calc_routeLastLeg(_ep_parent_route(i_workRoute));
					!	_ep_tmp_vesselActivityType(     i_route, i_leg ) := ep_calc_vesselActivityType(     i_route, i_leg );
					!	_ep_tmp_vesselActivityLocation( i_route, i_leg ) := ep_calc_vesselActivityLocation( i_route, i_leg );
					!	_ep_tmp_vesselActivityFirst(    i_route, i_leg ) := ep_calc_vesselActivityFirst(    i_route, i_leg );
					!	_ep_tmp_vesselActivityLast(     i_route, i_leg ) := ep_calc_vesselActivityLast(     i_route, i_leg );
						ep_calc_vesselActivityType(     i_workRoute, i_leg ) := _ep_tmp_vesselActivityType(     _ep_parent_route(i_workRoute), i_leg);
						ep_calc_vesselActivityCargo(    i_workRoute, i_leg ) := _ep_tmp_vesselActivityCargo(    _ep_parent_route(i_workRoute), i_leg);
						ep_calc_vesselActivityLocation( i_workRoute, i_leg ) := _ep_tmp_vesselActivityLocation( _ep_parent_route(i_workRoute), i_leg);
						ep_calc_vesselActivityFirst(    i_workRoute, i_leg ) := _ep_tmp_vesselActivityFirst(    _ep_parent_route(i_workRoute), i_leg);
						ep_calc_vesselActivityLast(     i_workRoute, i_leg ) := _ep_tmp_vesselActivityLast(     _ep_parent_route(i_workRoute), i_leg);
					
						! Second, append the legs for handling i_act_cargo:
						! - sailing towards pickup location, 
						! - perhaps waiting for the cargo to become available, 
						! - sailing towards delivery location.
						!DebuggerBreakpoint();
						_ep_loc_lastLeg(i_workRoute) := ep_calc_routeLastLeg(_ep_parent_route(i_workRoute));
						_ep_debug_loadingPortsCargo(i_workRoute) := ep_loadingPortsCargo( _ep_last_cargo( i_workRoute ));
						_bp_tmp_SailToPickup(i_workRoute) := 
							 ep_temp_lastLocation( _ep_parent_route(i_workRoute) ) <> ep_loadingPortsCargo( _ep_last_cargo( i_workRoute ));
						_ep_loc_lastLeg(i_workRoute) $ ( _bp_tmp_SailToPickup(i_workRoute) and 
							( ep_calc_vesselActivityType( i_workRoute, _ep_loc_lastLeg(i_workRoute) ) <> ep_def_vesselIdleRetired ) )
							+= 1 ;
						ep_calc_vesselActivityType(     i_workRoute, _ep_loc_lastLeg(i_workRoute) ) $ _bp_tmp_SailToPickup(i_workRoute) := ep_def_vesselSailingPickup ;
						ep_calc_vesselActivityCargo(    i_workRoute, _ep_loc_lastLeg(i_workRoute) ) $ _bp_tmp_SailToPickup(i_workRoute) := _ep_last_cargo( i_workRoute ) ;
						ep_calc_vesselActivityLocation( i_workRoute, _ep_loc_lastLeg(i_workRoute) ) $ _bp_tmp_SailToPickup(i_workRoute) := ep_loadingPortsCargo(_ep_last_cargo( i_workRoute )) ;
						ep_calc_vesselActivityFirst(    i_workRoute, _ep_loc_lastLeg(i_workRoute) ) $ _bp_tmp_SailToPickup(i_workRoute) := ep_calc_vesselActivityFirst(    i_workRoute, _ep_loc_lastLeg(i_workRoute) ) ; ! so no change.
						ep_calc_vesselActivityLast(     i_workRoute, _ep_loc_lastLeg(i_workRoute) ) $ _bp_tmp_SailToPickup(i_workRoute) := _ep_loc_arrivalDay( _ep_parent_route(i_workRoute), _ep_last_cargo( i_workRoute ) );
					
						! - perhaps waiting for the cargo to become available, 
						_bp_tmp_WaitingForCargoAvailability(i_workRoute) := _ep_loc_arrivalDay( _ep_parent_route(i_workRoute), _ep_last_cargo( i_workRoute )) < ep_minTimeWindow(_ep_last_cargo( i_workRoute )) ;
						_ep_loc_lastLeg(i_workRoute) $ ( _bp_tmp_WaitingForCargoAvailability(i_workRoute) and 
							( ep_calc_vesselActivityType( i_workRoute, _ep_loc_lastLeg(i_workRoute) ) <> ep_def_vesselIdleRetired ) )
							+= 1 ;
						ep_calc_vesselActivityType(     i_workRoute, _ep_loc_lastLeg(i_workRoute)) $ _bp_tmp_WaitingForCargoAvailability(i_workRoute) := ep_def_vesselIdleWaitCargo;
						ep_calc_vesselActivityCargo(    i_workRoute, _ep_loc_lastLeg(i_workRoute)) $ _bp_tmp_WaitingForCargoAvailability(i_workRoute) := _ep_last_cargo( i_workRoute );
						ep_calc_vesselActivityLocation( i_workRoute, _ep_loc_lastLeg(i_workRoute)) $ _bp_tmp_WaitingForCargoAvailability(i_workRoute) := ep_loadingPortsCargo( _ep_last_cargo( i_workRoute ) );
						ep_calc_vesselActivityFirst(    i_workRoute, _ep_loc_lastLeg(i_workRoute)) $ _bp_tmp_WaitingForCargoAvailability(i_workRoute) := _ep_loc_arrivalDay( _ep_parent_route(i_workRoute), _ep_last_cargo( i_workRoute ) ); 
						ep_calc_vesselActivityLast(     i_workRoute, _ep_loc_lastLeg(i_workRoute)) $ _bp_tmp_WaitingForCargoAvailability(i_workRoute) := ep_minTimeWindow(_ep_last_cargo( i_workRoute ));
					
						! - sailing towards delivery location.
						_ep_loc_lastLeg(i_workRoute) += 1;
						ep_calc_vesselActivityType(     i_workRoute, _ep_loc_lastLeg(i_workRoute) ) := ep_def_vesselSailingDelivery;
						ep_calc_vesselActivityCargo(    i_workRoute, _ep_loc_lastLeg(i_workRoute) ) := _ep_last_cargo( i_workRoute );
						ep_calc_vesselActivityLocation( i_workRoute, _ep_loc_lastLeg(i_workRoute) ) := ep_deliveringPortsCargo(                               _ep_last_cargo( i_workRoute ) );
						ep_calc_vesselActivityFirst(    i_workRoute, _ep_loc_lastLeg(i_workRoute) ) := _ep_loc_pickupDay(      _ep_parent_route(i_workRoute), _ep_last_cargo( i_workRoute ) ); 
						ep_calc_vesselActivityLast(     i_workRoute, _ep_loc_lastLeg(i_workRoute) ) := _ep_loc_nextSailingDay( _ep_parent_route(i_workRoute), _ep_last_cargo( i_workRoute ) );
					
						! - Always reserving a leg to wait till end of horizon.
						_ep_loc_lastLeg(i_workRoute) += 1;
						ep_calc_vesselActivityType(     i_workRoute, _ep_loc_lastLeg(i_workRoute)) := ep_def_vesselIdleRetired;
						ep_calc_vesselActivityCargo(    i_workRoute, _ep_loc_lastLeg(i_workRoute)) := _ep_last_cargo( i_workRoute );
						ep_calc_vesselActivityLocation( i_workRoute, _ep_loc_lastLeg(i_workRoute)) := ep_deliveringPortsCargo(_ep_last_cargo( i_workRoute ));
						ep_calc_vesselActivityFirst(    i_workRoute, _ep_loc_lastLeg(i_workRoute)) := _ep_loc_nextSailingDay(_ep_parent_route(i_workRoute), _ep_last_cargo( i_workRoute )); 
						ep_calc_vesselActivityLast(     i_workRoute, _ep_loc_lastLeg(i_workRoute)) := ep_def_finishHorizonDate;
					
						_ep_tmp_vesselActivityType(     i_workRoute, i_leg ) := ep_calc_vesselActivityType(     i_workRoute, i_leg );
						_ep_tmp_vesselActivityCargo(    i_workRoute, i_leg ) := ep_calc_vesselActivityCargo(    i_workRoute, i_leg );
						_ep_tmp_vesselActivityLocation( i_workRoute, i_leg ) := ep_calc_vesselActivityLocation( i_workRoute, i_leg );
						_ep_tmp_vesselActivityFirst(    i_workRoute, i_leg ) := ep_calc_vesselActivityFirst(    i_workRoute, i_leg );
						_ep_tmp_vesselActivityLast(     i_workRoute, i_leg ) := ep_calc_vesselActivityLast(     i_workRoute, i_leg );
					
					
						! - Finishing up admin.
						ep_calc_routeLastLeg(i_workRoute) := _ep_loc_lastLeg(i_workRoute);
					
						! Move the working list again to the input list.
						_s_inputList := s_temp_routeWorkingList ;
						s_temp_routeWorkingList := {};
					
					endwhile;
				}
				Set _s_inputList {
					SubsetOf: s_calc_feasibleRoutes;
					Index: _i_inputRoute;
				}
				Set _s_processedRoutes {
					SubsetOf: s_calc_feasibleRoutes;
				}
				ElementParameter _ep_loc_arrivalDay {
					IndexDomain: (_i_inputRoute, i_cargo);
					Range: cal_days;
				}
				ElementParameter _ep_loc_pickupDay {
					IndexDomain: (_i_inputRoute,i_cargo);
					Range: cal_days;
				}
				ElementParameter _ep_loc_nextSailingDay {
					IndexDomain: (_i_inputRoute,i_cargo);
					Range: cal_days;
				}
				Set _s_next_potential_cargos {
					IndexDomain: _i_inputRoute;
					SubsetOf: s_cargoes;
				}
				Index _i_next_cargo {
					Range: s_cargoes;
				}
				ElementParameter _ep_next_route {
					IndexDomain: (_i_inputRoute,_i_next_cargo);
					Range: s_calc_feasibleRoutes;
				}
				ElementParameter _ep_parent_route {
					IndexDomain: i_route;
					Range: s_calc_feasibleRoutes;
				}
				ElementParameter _ep_last_cargo {
					IndexDomain: i_route;
					Range: s_cargoes;
				}
				ElementParameter _ep_loc_lastLeg {
					IndexDomain: i_route;
					Range: s_calc_legs;
				}
				Parameter _bp_tmp_SailToPickup {
					IndexDomain: i_route;
					Range: binary;
				}
				Parameter _bp_tmp_WaitingForCargoAvailability {
					IndexDomain: i_route;
					Range: binary;
				}
				ElementParameter _ep_debug_loadingPortsCargo {
					IndexDomain: i_workRoute;
					Range: s_locations;
				}
				ElementParameter _ep_tmp_pickupDate {
					IndexDomain: (i_route,i_cargo);
					Range: cal_days;
				}
				ElementParameter _ep_tmp_vesselActivityType {
					IndexDomain: (i_route, i_leg);
					Range: s_def_vesselActivities;
				}
				ElementParameter _ep_tmp_vesselActivityCargo {
					IndexDomain: (i_route, i_leg);
					Range: s_cargoes;
				}
				ElementParameter _ep_tmp_vesselActivityLocation {
					IndexDomain: (i_route,i_leg);
					Range: s_locations;
					Comment: {
						"For activities ep_vesselIdleWaitCargo and ep_vesselIdleRetired
						the location where the vessel is at.
						For activities ep_vesselSailingPickup  and ep_vesselSailingDelivery  the
						location where the vessel is sailing towards."
					}
				}
				ElementParameter _ep_tmp_vesselActivityFirst {
					IndexDomain: (i_route,i_leg);
					Range: cal_days;
					Comment: "First day of this vessel activity.";
				}
				ElementParameter _ep_tmp_vesselActivityLast {
					IndexDomain: (i_route,i_leg);
					Range: cal_days;
				}
			}
		}
	}
	Procedure MainExecution {
		Comment: "Main solve procedure for the WebUI: delegates to AIMMS PRO server when running in cloud or end-user mode, otherwise solves locally, then updates the WebUI pages with the solution.";
		Body: {
			! Check if connected to PRO or running as an end-user
			if pro::GetPROEndPoint() or not ProjectDeveloperMode() then
			
			    ! Delegate model execution to the AIMMS PRO server
			    if pro::DelegateToServer( 
			        procedureName      :  'mm::pr_runModel',        ! Procedure to run remotely
			        waitForCompletion  :  1,                       ! Wait for the job to finish
			        completionCallback :  'pro::session::LoadResultsCallBack' ) ! Fetch results after completion
			    then 
			
			        mm::pr_updatePagesAfterSolve; ! Update the WebUI with the solution
			
			    endif;
			else
				! Execute model 
			    mm::pr_runModel;
			    mm::pr_updatePagesAfterSolve; ! Update the WebUI with the solution
			
			endif;
		}
	}
	Section Python_Bridge_Support {
		Comment: "Support sections for integrating Python-based sea-route distance calculations and the AIMMS-Python bridge for the vessel scheduling model.";
		Section aimmspy_Leverage {
			Comment: "Procedures that use the AIMMS-Python (aimmspy) bridge to exchange data with Python scripts for sea-route distance computation.";
			Procedure pr_processPythonInput {
				Comment: "Maps the string-based loading and delivering port identifiers (from Python) to AIMMS s_locations elements, and raises warnings for unrecognized port names.";
				Body: {
					! Display the set of valid locations
					block where single_column_display := 1;
						display s_locations ;
					endblock ;
					
					! Map loading port string input to a location element using s_locations
					ep_loadingPortsCargo( i_cargo ) := StringToElement( s_locations, sp_loadingPortsCargo(i_cargo) );
					! Map delivering port string input to a location element using s_locations
					ep_deliveringPortsCargo( i_cargo ) := StringToElement( s_locations, sp_deliveringPortsCargo(i_cargo) );
					
					for i_cargo do ! Validate mapped ports for all cargoes
						! Check if loading port was successfully found in s_locations
						if not ep_loadingPortsCargo( i_cargo ) then
							raise warning formatString("loading port for %e: '%s' not recognized", i_cargo, sp_loadingPortsCargo(i_cargo) );
						endif ;
						! Check if delivering port was successfully found
						if not ep_deliveringPortsCargo( i_cargo ) then
							raise warning formatString("loading port for %e: '%s' not recognized", i_cargo, sp_deliveringPortsCargo(i_cargo) );
						endif ;
					endfor ;
					
					! Display both the original string inputs and the resulting element mappings
					display {sp_loadingPortsCargo, sp_deliveringPortsCargo,ep_loadingPortsCargo,ep_deliveringPortsCargo};
				}
			}
			Procedure pr_echoInput {
				Comment: "Displays all input data (horizon start, location data, cargo data, vessel data) to the AIMMS listing for debugging and verification purposes.";
				Body: {
					! Display the model's planning start date
					display ep_startHorizonDate ;
					
					! Location data: Display coordinates and various location costs
					display { p_latitude, p_longitude, p_idleCostLocation, p_adminCostAtLocation, p_loadingCostAtLocation } ;
					
					! Cargo Data: Display assignment elements, costs, and time window constraints
					display { ep_loadingPortsCargo, ep_deliveringPortsCargo, p_spotCostVessel, ep_minTimeWindow,
						ep_maxTimeWindow, p_cargoCost} ;
					
					! Vessel Data: Display vessel origin and sailing costs
					display { ep_originPortOfVessel, p_sailingCost } ;
				}
			}
			Procedure pr_genRoutesSolve {
				Comment: "Activates all master data, sets default vessel velocity if needed, runs the model, and executes post-processing to extract vessel, cargo, and route results.";
				Body: {
					! Set a default value for vessel velocity if it's currently undefined
					if not p_vesselVelocity then
						p_vesselVelocity := 37.04 [km/hour];
					endif ;
					
					!Activate all master data
					! Set boolean activation flags to 1 (True) for all elements in the respective sets
					bp_activeCargoes(i_cargo):= 1;
					bp_activeVessels(i_vessel) := 1;
					bp_activeLocations(i_loc) := 1;
					
					mm::pr_runModel; ! Execute the main model solution procedure
					
					!Post Execution: Run procedures to process, calculate, and store final results
					mm::pr_post_vesselResults();
					mm::pr_post_cargoResults();
					mm::pr_post_routeResults();
				}
			}
			Procedure pr_echoOutput {
				Comment: "Displays all solution output data (vessel results, cargo overview, route overview) to the AIMMS listing for debugging purposes.";
				Body: {
					! --- Vessel Results ---
					display { 
						mm::ep_post_routeOfVessel,          ! Vessel's assigned route sequence
						mm::p_post_operationalCostPerVessel, ! Calculated operational cost per vessel
						mm::p_post_totalTravelDaysPerVessel  ! Calculated total travel time per vessel
					} ;
					
					! --- Cargo Overview ---
					display { 
						mm::ep_post_vesselOfCargo,         ! Assigned vessel for the cargo
						mm::p_post_totalCostPerCargo,      ! Total calculated cost per cargo
						mm::sp_post_loadingTimePerCargo,   ! Scheduled cargo loading time (as a string)
						mm::sp_post_deleveringTimePerCargo ! Scheduled cargo delivery time (as a string)
					} ;
					
					! --- Route Overview ---
					display { 
						mm::ep_post_vesselActivityType,      ! Type of activity (e.g., Load, Sail) at each route step
						mm::ep_post_vesselActivityLocation,  ! Location/port for each activity step
						mm::ep_post_vesselActivityFirst,     ! Index of the first activity for a vessel
						mm::ep_post_vesselActivityLast       ! Index of the last activity for a vessel
					};
				}
			}
		}
		Module LeveragePythonAimms {
			Prefix: lpa;
			Comment: "Module providing a Python-based sea-route calculation service, exposing a procedure to retrieve waypoints and route length for a pair of locations.";
			Parameter p_scalar {
				Comment: "Scalar parameter used for testing the AIMMS-Python scalar data exchange.";
			}
			Parameter p_globRouteLength {
				Comment: "Global output parameter storing the total route length returned by the Python sea-route function.";
			}
			Set s_globWaypoints {
				SubsetOf: Integers;
				Index: i_globWayPoint;
				Comment: "Global set of integer indices representing the waypoints returned by the Python sea-route function.";
			}
			Parameter p_globLat {
				IndexDomain: i_globWayPoint;
				Comment: "Latitude of each waypoint i_globWayPoint returned by the Python sea-route function.";
			}
			Parameter p_globLon {
				IndexDomain: i_globWayPoint;
				Comment: "Longitude of each waypoint i_globWayPoint returned by the Python sea-route function.";
			}
			Procedure pr_testScalar {
				Comment: "Test procedure that scans the Python source and invokes the test_scalar Python function to verify scalar data exchange.";
				Body: {
					pr_scanPythonSource();
					py::run_python_statement("test_scalar(\"lpa::p_scalar\")");
				}
			}
			Procedure pr_getRoute {
				Arguments: (ep_from,ep_to,p_routeLength,s_waypoints,p_latWP,p_lonWP);
				Comment: "Calls the Python searoute_route2 function to retrieve the sea route between ep_from and ep_to, storing the route length in p_routeLength and the waypoint coordinates in s_waypoints/p_latWP/p_lonWP.";
				Body: {
					! --- Input Validation ---
					block ! Sanity check for route definition elements
						if not ep_from then
							raise error "lpa::pr_getRoute.ep_from is not specified" ; ! Start location must be defined
						endif ;
						if not ep_to then
							raise error "lpa::pr_getRoute.ep_to is not specified" ; ! End location must be defined
						endif ;
						if ep_from = ep_to then
							raise error "lpa::pr_getRoute.ep_from should be different from lpa::pr_getRoute.ep_to" ; ! Start and end must be distinct
						endif ;
					endblock ;
					
					! Retrieve coordinates for the start and end locations
					_p_fromLat := p_latitude( ep_from );
					_p_fromLon := p_longitude( ep_from );
					_p_toLat := p_latitude( ep_to );
					_p_toLon := p_longitude( ep_to );
					
					! --- External Python Route Calculation ---
					! Prototype searoute_route2 (for reference)
					! def searoute_route2(fromLat:float,fromLon:float,toLat:float,toLon:float,
					!     indexName:str,latParName:str,lonParName:str,lenParName:str):
					
					! Prepare Python call string, injecting coordinates and AIMMS output identifiers
					! Five decimals (%12.5n) provides a location precision of roughly 1 meter, sufficient for maritime routes.
					_sp_pyCall := formatString("searoute_route2(%12.5n,%12.5n,%12.5n,%12.5n,\"lpa::i_globWayPoint\",\"lpa::p_globLat\",\"lpa::p_globLon\",\"lpa::p_globRouteLength\")",
						_p_fromLat, _p_fromLon, _p_toLat, _p_toLon );
					pr_scanPythonSource();        ! Ensure Python environment is ready
					py::run_python_statement(_sp_pyCall); ! Execute the external route calculation
					
					! --- Store Results ---
					! Copy calculated results from global/temporary storage to local parameters
					s_waypoints := s_globWaypoints ; 
					p_latWP(i_waypoint) := p_globLat(i_waypoint);
					p_lonWP(i_waypoint) := p_globLon(i_waypoint);
					p_routeLength := p_globRouteLength;
				}
				ElementParameter ep_from {
					Range: s_locations;
					Property: Input;
				}
				ElementParameter ep_to {
					Range: s_locations;
					Property: Input;
				}
				Set s_waypoints {
					SubsetOf: Integers;
					Index: i_waypoint;
					Property: Output;
				}
				Parameter p_lonWP {
					IndexDomain: i_waypoint;
					Property: Output;
				}
				Parameter p_latWP {
					IndexDomain: i_waypoint;
					Property: Output;
				}
				Parameter p_routeLength {
					Property: Output;
				}
				Parameter _p_fromLat;
				Parameter _p_fromLon;
				Parameter _p_toLat;
				Parameter _p_toLon;
				StringParameter _sp_pyCall;
			}
		}
		Section pyaimms_Leverage {
			Comment: "Procedures and parameters for computing and caching sea-route distances using the Python searoute library, and toggling between Haversine and sea-route distance modes.";
			StringParameter sp_seaRouteDistanceFilename {
				Comment: "Path to the Parquet file storing the pre-computed sea-route distance matrix between all location pairs.";
				Definition: "data/distanceMatrixFromSeaRoute.parquet";
			}
			Parameter p_totlen {
				Comment: "Total length of the last sea route computed during a test call.";
			}
			Parameter p_nowaypoints {
				Comment: "Number of waypoints in the last sea route computed during a test call.";
			}
			Set s_waypoints {
				SubsetOf: Integers;
				Index: i_wayno;
				Property: ElementsAreLabels;
				Comment: "Set of integer indices for the waypoints of the last sea route computed during a test call.";
			}
			Parameter p_wayLat {
				IndexDomain: i_wayno;
				Comment: "Latitude of each waypoint i_wayno for the last sea route computed during a test call.";
			}
			Parameter p_wayLon {
				IndexDomain: i_wayno;
				Comment: "Longitude of each waypoint i_wayno for the last sea route computed during a test call.";
			}
			Parameter p_origLat {
				Comment: "Latitude of the origin location used during a sea-route test call.";
			}
			Parameter p_origLon {
				Comment: "Longitude of the origin location used during a sea-route test call.";
			}
			Parameter p_destLat {
				Comment: "Latitude of the destination location used during a sea-route test call.";
			}
			Parameter p_destLon {
				Comment: "Longitude of the destination location used during a sea-route test call.";
			}
			Parameter p_distance_searoute {
				IndexDomain: (i_loc_from,i_loc_to);
				Comment: "Pre-computed sea-route distance in km between location i_loc_from and i_loc_to, loaded from the Parquet distance matrix file.";
			}
			Parameter bp_use_searoute_distances {
				Range: binary;
				InitialData: 0;
				Comment: "When 1, p_def_distanceBetweenLocations uses the sea-route distances from p_distance_searoute; when 0, it uses Haversine distances.";
			}
			Parameter bp_python_source_scanned {
				Range: binary;
				Property: NoSave;
				InitialData: 0;
				Comment: "Flag indicating whether the Python source script has already been executed in the current session; prevents redundant re-execution.";
			}
			Procedure pr_testGetRoute {
				Comment: "Test procedure that validates sea-route retrieval between two hardcoded locations (Caldera,Chile and Bahia Blanca,Argentina), displaying the route length and waypoint coordinates.";
				Body: {
					! --- Precondition Check ---
					if not card( s_locations ) then
						raise error "location data not yet read in" ; ! Stop execution if location data set is empty
					endif ;
					
					! --- Set up Route Endpoints ---
					_ep_from := StringToElement(s_locations,"Caldera,Chile");         ! Convert string to element for 'from' location
					_ep_to   := StringToElement(s_locations,"Bahia Blanca,Argentina"); ! Convert string to element for 'to' location
					
					! --- Execute Route Calculation Procedure ---
					lpa::pr_getRoute(                                 ! Call the procedure to calculate the route
						ep_from       :  _ep_from,                   ! Start point
						ep_to         :  _ep_to,                     ! End point
						p_routeLength :  _p_len,                     ! Output parameter for route length
						s_waypoints   :  _s_wp,                      ! Output set for waypoints
						p_latWP       :  _p_latwp,                   ! Output parameter for waypoint latitude
						p_lonWP       :  _p_lonwp);                  ! Output parameter for waypoint longitude
					
					! --- Display Results ---
					block where listing_number_precision := 5 ; ! Set display precision for output
						display _p_len ;                           ! Display the calculated route length
						display { _p_latwp, _p_lonwp } ;           ! Display the coordinates of all intermediate waypoints
					endblock ;
				}
				ElementParameter _ep_from {
					Range: s_locations;
				}
				ElementParameter _ep_to {
					Range: s_locations;
				}
				Set _s_wp {
					SubsetOf: Integers;
					Index: _i_wp;
				}
				Parameter _p_latwp {
					IndexDomain: _i_wp;
				}
				Parameter _p_lonwp {
					IndexDomain: _i_wp;
				}
				Parameter _p_len;
			}
			Procedure pr_scanPythonSource {
				Comment: "Ensures the Python script 'leverage-sea-route.py' is executed once per session to make the sea-route functions available for subsequent Python calls.";
				Body: {
					! --- Python Initialization ---
					! Check if the Python source code has already been executed/scanned
					if not bp_python_source_scanned then
					
						! Execute the specified Python script 
						py::run_python_script("leverage-sea-route.py");
					
						! Set the flag to True (1) to prevent the script from being run again
						bp_python_source_scanned := 1;
					
					endif ;
				}
			}
			Procedure pr_testSeaRoute {
				Comment: "Test procedure that calls the Python searoute_route function for two hardcoded locations, displaying validated elements and their coordinates.";
				Body: {
					! --- Define and Validate Endpoints ---
					ep_locOrig := StringToElement(s_locations, "Ponta da Madeira,Brazil"); ! Convert origin string to location element
					ep_locDest := StringToElement(s_locations, "Puerto Prodeco,Colombia");   ! Convert destination string to location element
					
					if not ep_locOrig then
						raise warning "origin location not found" ; ! Raise warning if origin is not in s_locations
					endif ;
					if not ep_locDest then
						raise warning "destination location not found" ; ! Raise warning if destination is not in s_locations
					endif ;
					
					! Retrieve coordinates using the validated elements
					p_origLat := p_latitude( ep_locOrig );
					p_origLon := p_longitude( ep_locOrig );
					p_destLat := p_latitude( ep_locDest );
					p_destLon := p_longitude( ep_locDest );
					
					! Display validated elements and their coordinates
					display ep_locOrig, ep_locDest,
						p_origLat, p_origLon,
						p_destLat, p_destLon ;
					
					! --- Python Route Calculation ---
					s_waypoints := ElementRange(0,100); ! Initialize a set for storing up to 101 waypoints
					pr_scanPythonSource();            ! Ensure Python environment is ready
					_sp_pyCall := formatString("searoute_route(%12.7n,%12.7n,%12.7n,%12.7n)", ! Prepare Python function call string with coordinates
						p_origLat, p_origLon, p_destLat, p_destLon );
					py::run_python_statement(_sp_pyCall); ! Execute the external route calculation function
				}
				ElementParameter ep_locOrig {
					Range: s_locations;
				}
				ElementParameter ep_locDest {
					Range: s_locations;
				}
				StringParameter _sp_pyCall;
			}
			Procedure pr_distanceMatrixFromSeaRoute {
				Comment: "Computes the full sea-route distance matrix for all location pairs by calling the Python searoute_distance_matrix function.";
				Body: {
					pr_scanPythonSource();
					py::run_python_statement("searoute_distance_matrix()");
				}
			}
			Procedure pr_saveSeaRouteDistanceMatrixToParquet {
				Comment: "Exports the sea-route distance matrix from p_distance_searoute to the Parquet file defined by sp_seaRouteDistanceFilename using the distanceMatrixParquet DEX mapping.";
				Body: {
					! --- Data Export Mapping Setup ---
					dex::AddMapping(
						mappingName :  "distanceMatrixParquet", ! Define a new Data Exchange mapping name
						mappingFile :  "Mappings/distanceMatrixParquet.xml"); ! Load mapping definition from XML file
					
					! --- Data Export Execution ---
					dex::WriteToFile(
						dataFile    :  sp_seaRouteDistanceFilename, ! Specify the target output filename/path
						mappingName :  "distanceMatrixParquet", ! Use the defined mapping to structure the output data
						pretty      :  1); ! Format the output file in a human-readable/pretty way (if applicable, e.g., for JSON/XML)
				}
			}
			Procedure pr_readSeaRouteDistanceMatrixFromParquet {
				Comment: "Reads the pre-computed sea-route distance matrix from the Parquet file defined by sp_seaRouteDistanceFilename into p_distance_searoute, without clearing existing identifiers or sets.";
				Body: {
					! --- Data Import Mapping Setup ---
					dex::AddMapping(
						mappingName :  "distanceMatrixParquet", ! Define a new Data Exchange mapping name
						mappingFile :  "Mappings/distanceMatrixParquet.xml"); ! Load mapping definition from XML file
					
					! --- Data Import Execution ---
					dex::ReadFromFile(
						dataFile         :  sp_seaRouteDistanceFilename, ! Specify the input file path/name
						mappingName      :  "distanceMatrixParquet", ! Use the defined mapping to interpret file structure
						emptyIdentifiers :  0, ! Do NOT clear identifiers not found in the file
						emptySets        :  0, ! Do NOT clear sets not found in the file
						resetCounters    :  0); ! Do NOT reset internal set counters
				}
			}
			Procedure pr_toggle_distance_computation {
				Comment: "Toggles between Haversine and sea-route distance modes: if sea-route is active, switches it off; if inactive, loads or computes the distance matrix and activates sea-route distances, updating the WebUI status bar.";
				Body: {
					! --- Toggle Distance Calculation/Usage ---
					if card( s_locations ) then ! Only proceed if location data has been loaded
					
						if bp_use_searoute_distances then ! Scenario 1: Sea route distances are currently active (Toggle OFF)
							ui::sp_systemStatusBar(2,'color') := "red";	! Update UI status bar color to indicate switch
							bp_use_searoute_distances := 0 ; ! Set flag to 0 (False) to stop using sea route distances
					
						else ! Scenario 2: Sea route distances are currently inactive (Toggle ON/Initialize)
					
							if not card( p_distance_searoute ) then ! Check if the distance matrix data is missing
					
								if FileExists( sp_seaRouteDistanceFilename ) then ! Check if the distance file exists locally
									pr_readSeaRouteDistanceMatrixFromParquet(); ! Read the pre-calculated distance matrix
					
								else ! File does not exist, calculation is required
									webui::SetProgressMessage("Computing Sea Routes - estimate: five to ten minutes"); ! Display progress to user
									pr_distanceMatrixFromSeaRoute();        ! Perform the time-consuming distance calculation
									pr_saveSeaRouteDistanceMatrixToParquet(); ! Save the newly calculated matrix to file
									webui::SetProgressMessage("");          ! Clear progress message
								endif ;
					
							endif ;
					
							ui::sp_systemStatusBar(2,'color') := "green"; ! Update UI status bar color to indicate activation
							ui::sp_systemStatusBar(2,'icon') := "aimms-checkmark-circle"; ! Change status bar icon
							bp_use_searoute_distances := 1 ; ! Set flag to 1 (True) to use sea route distances
						endif ;
					
					endif ;
				}
			}
		}
	}
	Section Library_Initialization_and_Termination {
		Comment: "Standard AIMMS model initialization and termination procedures for VesselScheduling.";
		Procedure MainInitialization {
			Body: {
				!ProfilerStart();

				pr_initCalendar;
			}
			Comment: "Add initialization statements here that do NOT require any library being initialized already.";
		}
		Procedure PostMainInitialization {
			Comment: {
				"Add initialization statements here that require that the libraries are already initialized properly,
				or add statements that require the Data Management module to be initialized."
			}
		}
		Procedure pr_startupProcedure {
			Comment: "Startup procedure that either handles existing generated DEX dataset annotations or generates new mappings, then reads all DEX mappings into memory.";
			Body: {
				if DirectoryExists( "Mappings/Generated" ) then
					dex::HandleDatasetAnnotations(); ! Needed for dex::DatasetTableMapping
				else
					dex::GenerateDatasetMappings();
				endif;
				
				dex::ReadAllMappings();
			}
		}
		Procedure PreMainTermination {
			Body: {
				return 1;!DataManagementExit();
			}
			Comment: {
				"Add termination statements here that require all libraries to be still alive.
				Return 1 if you allow the termination sequence to continue.
				Return 0 if you want to cancel the termination sequence."
			}
		}
		Procedure MainTermination {
			Body: {
				return 1;
			}
			Comment: {
				"Add termination statements here that do not require all libraries to be still alive.
				Return 1 to allow the termination sequence to continue.
				Return 0 if you want to cancel the termination sequence.
				It is recommended to only use the procedure PreMainTermination to cancel the termination sequence and let this procedure always return 1."
			}
		}
	}
}
