		Section Overview_Datasets_Page {
			Procedure pr_onPageOpenOverviewDatasets {
				Body: {
					webui::OpenPage(pageId :  'locations_overview');
				}
			}
		}
		Section Locations_Page {
			Set s_def_locationsNotInUsage {
				SubsetOf: s_locations;
				Index: i_loc_not_usag;
				Definition: s_locations - s_def_locationsInUsage;
				webui::AnnotationsIdentifier: sp_locationNotInUsageAnnotation(ui::i_loc_not_usag);
			}
			StringParameter sp_locationNotInUsageIcon {
				IndexDomain: i_loc_not_usag;
				Definition: "aimms-cross3";
			}
			Parameter p_locationNotInUsageSize {
				IndexDomain: i_loc_not_usag;
				Definition: 3;
				webui::TooltipIdentifier: sp_locationNotInUsageTooltip(i_loc_not_usag);
			}
			StringParameter sp_locationNotInUsageTooltip {
				IndexDomain: i_loc_not_usag;
				Definition: {
					formatString("No cargo or vessel need to go to this Location (%e).",
						i_loc_not_usag )
				}
			}
			StringParameter sp_locationNotInUsageAnnotation {
				IndexDomain: i_loc_not_usag;
				Definition: "NotInUse";
			}
			Set s_def_locationsInUsage {
				SubsetOf: s_locations;
				Index: i_loc_usag, i_loc_usag2;
				Parameter: ep_locationInUsage;
				Definition: {
					{i_act_loc | 
					        exists(i_act_cargo | i_act_loc = ep_def_loadingPortsCargo(i_act_cargo))
					        or exists(i_act_cargo | i_act_loc = ep_def_deliveringPortsCargo(i_act_cargo))
					        or exists(i_act_vessel | i_act_loc = ep_originPortOfVessel(i_act_vessel))}
				}
				webui::AnnotationsIdentifier: sp_locationInUsageAnnotation(ui::i_loc_usag);
			}
			StringParameter sp_locationInUsageIcon {
				IndexDomain: i_loc_usag;
				Definition: "aimms-cube4";
			}
			Parameter p_locationInUsageSize {
				IndexDomain: i_loc_usag;
				Definition: 12;
				webui::TooltipIdentifier: ui::sp_def_locationInUsageTooltip(ui::i_loc_usag);
			}
			StringParameter sp_def_locationInUsageTooltip {
				IndexDomain: i_loc_usag;
				Definition: "There is at least one cargo or vessel that needs to come to this Location.";
			}
			StringParameter sp_locationInUsageAnnotation {
				IndexDomain: i_loc_usag;
				Definition: "InUse";
			}
			StringParameter sp_def_distanceTitle {
				Definition: "Distance from \"" + ep_location + "\"";
			}
			StringParameter sp_def_focusedLocationFrom {
				IndexDomain: (i_loc);
				Definition: {
					if ep_location = i_loc then
					    "highlight-cell"
					else 
					    ""
					endif;
				}
			}
			Procedure pr_uponLoadLocationsPage {
				Body: {
					if not ep_location then
					    ep_location := first(i_loc);
					endif;
				}
			}
		}
		Section Cargoes_Page {
			Set s_def_visibleCargoLocations {
				SubsetOf: s_locations;
				Index: i_loc_visiblecargo;
				Definition: {
					{i_loc |  
					    ep_loadingPortsCargo(ep_cargo) = i_loc 
					    or ep_deliveringPortsCargo(ep_cargo) = i_loc}
				}
			}
			StringParameter sp_def_cargoesMapIcon {
				IndexDomain: i_loc;
				Definition: {
					if (i_loc in s_def_loadingPorts)  then
					    "aimms-esc"    
					
					elseif (i_loc in s_def_deleveringPorts) then
					    "aimms-enter6"
					
					endif;
				}
			}
			Parameter p_def_cargoesMapSize {
				IndexDomain: i_Loc;
				Definition: 12;
				webui::AnnotationsIdentifier: ui::sp_def_cargoesMapAnnotation(i_Loc);
			}
			StringParameter sp_def_cargoesMapAnnotation {
				IndexDomain: i_loc;
				Definition: {
					if (ep_loadingPortsCargo(ep_cargo) = i_loc)  then
					    "LoadingPort"    
					
					elseif (ep_deliveringPortsCargo(ep_cargo) = i_loc) then
					    "DeliveringPort"
					
					endif;
				}
			}
			Parameter p_def_deliveringToLoadingPorts {
				IndexDomain: (i_loc_from,i_loc_to);
				Unit: day;
				Definition: {
					p_def_distanceBetweenLocations(i_loc_from, i_loc_to) $
					        (i_loc_from = ep_def_loadingPortsCargo(ep_cargo)
					        and i_loc_to = ep_def_deliveringPortsCargo(ep_cargo))
				}
				webui::TooltipIdentifier: sp_def_deliveringToLoadingPortsTooltip(i_loc_from,i_loc_to);
			}
			StringParameter sp_def_deliveringToLoadingPortsTooltip {
				IndexDomain: (i_loc_from,i_loc_to);
				Definition: {
					FormatString("From: %e<br>To: %e.", i_loc_from, i_loc_to);
				}
			}
			StringParameter sp_def_focusedCargo {
				IndexDomain: i_cargo;
				Definition: {
					if ep_cargo = i_cargo then
					    "highlight-cell"
					else 
					    ""
					endif;
				}
			}
			Procedure pr_onPageOpenCargoes {
				Body: {
					ep_cargo := first(i_cargo);
				}
			}
		}
		Section Vessel_Page {
			StringParameter sp_def_vesselOriginPortIcon {
				IndexDomain: i_locVess;
				Definition: "aimms-ship";
			}
			Parameter p_def_vesselOriginPortSize {
				IndexDomain: i_locVess;
				Definition: 12;
				webui::AnnotationsIdentifier: sp_vesselOriginPortAnnotation(i_locVess);
				webui::TooltipIdentifier: sp_vesselOriginPortTooltip(i_locVess);
			}
			StringParameter sp_vesselOriginPortTooltip {
				IndexDomain: i_locVess;
				Definition: first(i_vessel | ep_originPortOfVessel(i_vessel) = i_locVess);
			}
			StringParameter sp_vesselOriginPortAnnotation {
				IndexDomain: i_locVess;
				Definition: "InUse";
			}
		}
		Section Itineraries_Page {
			Comment: "AKA the route details.";
			Procedure pr_uponLoadPageGeneratedItineraries {
				Body: {
					if not ep_selectedRoute then
						ep_selectedRoute := first(s_calc_usedRoutes);
					endif ;
				}
			}
			DeclarationSection Scalar_Details {
				StringParameter sp_def_titleScalarSelectRoute {
					Definition: "Select Route for Details";
				}
				ElementParameter ep_selectedRoute {
					Range: s_calc_usedRoutes;
					InitialData: '';
				}
				ElementParameter ep_def_selectedVessel {
					Range: s_vessels;
					Definition: ep_calc_routeVessel(ep_selectedRoute);
				}
				ElementParameter ep_berthVesselSelectedRoute {
					Range: s_locations;
					Definition: ep_originPortOfVessel( ep_def_selectedVessel );
				}
				Parameter p_def_noDaysSailing {
					Unit: day;
					Definition: p_def_routeSailingDays( ep_selectedRoute );
				}
				Parameter p_def_noDaysIdle {
					Unit: day;
					Definition: p_def_routeIdleDays( ep_selectedRoute );
				}
				Parameter p_def_totalSailingCostPerRoute {
					Unit: $;
					Definition: p_def_routeSailingCost(ep_selectedRoute);
				}
				Parameter p_def_totalIdleCostPerRoute {
					Unit: $;
					Definition: p_def_routeIdleCost(ep_selectedRoute);
				}
				Parameter p_def_totalVisitingLocationCostPerRoute {
					Unit: $;
					Definition: p_def_visitingLocationCost(ep_selectedRoute);
				}
				Parameter p_def_totalCargoCostPerRoute {
					Unit: $;
					Definition: p_def_cargoCost(ep_selectedRoute);
				}
				Parameter p_def_totalRouteCostPerRoute {
					Unit: $;
					Definition: p_def_routeCosts(ep_selectedRoute);
				}
			}
			StringParameter sp_def_titleTableHandledCargos {
				Definition: {
					FormatString("Cargos handled by route \"%e\"", ep_selectedRoute);
				}
			}
			Set s_def_legs {
				SubsetOf: s_calc_legs;
				Index: i_leg;
				Definition: {
					{::i_leg | p_def_vesselActivityLength(ep_selectedRoute, ::i_leg)}
				}
			}
			Set s_def_cargosOfSelectedRoute {
				SubsetOf: s_cargoes;
				Index: i_cargoOfSelectedRoute;
				OrderBy: user;
				Definition: s_calc_cargosHandled(ep_selectedRoute);
			}
			ElementParameter ep_def_minTimeWindow {
				IndexDomain: i_cargo;
				Range: cal_days;
				Definition: ::ep_minTimeWindow(i_cargo);
			}
			ElementParameter ep_def_maxTimeWindow {
				IndexDomain: i_cargo;
				Range: cal_days;
				Definition: ::ep_maxTimeWindow(i_cargo);
			}
			ElementParameter ep_def_loadingPortsCargo {
				IndexDomain: i_cargo;
				Range: s_locations;
				Definition: ::ep_loadingPortsCargo(i_cargo);
			}
			ElementParameter ep_def_deliveringPortsCargo {
				IndexDomain: i_cargo;
				Range: s_locations;
				Definition: ::ep_deliveringPortsCargo(i_cargo);
			}
		}
		Section Detailed_Costs_Page {
			StringParameter sp_def_cargoIsSpotTooltip {
				IndexDomain: i_act_cargo;
				Definition: {
					if mm::bv_cargoOnCharteredVessel(i_act_cargo) then
					    "This is a spot cost."
					endif;
				}
			}
			Parameter p_def_totalCargoCost {
				Unit: $;
				Definition: sum(i_route, p_def_cargoCost(i_route));
			}
			Parameter p_def_totalSailingCost {
				Unit: $;
				Definition: sum(i_route, p_def_routeSailingCost(i_route));
			}
			Parameter p_def_totalVisitingLocationCost {
				Unit: $;
				Definition: sum(i_route, p_def_visitingLocationCost(i_route));
			}
			Parameter p_def_totalIdleCost {
				Unit: $;
				Definition: sum(i_route, p_def_routeIdleCost(i_route));
			}
			Parameter p_def_totalSpotCost {
				Unit: $;
				Definition: sum(i_act_cargo, mm::p_post_cargoSpotCost(i_act_cargo));
			}
			StringParameter sp_def_cargoNotDeliveredAnnotation {
				IndexDomain: i_act_cargo;
				Definition: {
					if not mm::ep_post_vesselOfCargo(i_act_cargo) then
					    "not-fulfilled"
					endif;
				}
			}
			StringParameter sp_def_vesselNotUsedAnnotation {
				IndexDomain: i_vessel;
				Definition: {
					if not mm::ep_post_routeOfVessel(i_vessel) then
					    "not-fulfilled"
					endif;
				}
			}
		}
		Section Visualizations_Page {
			DeclarationSection Page_Settings {
				StringParameter sp_tabbedWidgetContentsItineraryPage {
					IndexDomain: (webui::indexNoOfTabs,webui::indexTabSpec);
					Definition: {
						data { 
						  ( 1, displayText ) : "Map"      ,  
						  ( 1, pageId      ) : "visualize_map" ,  
						  ( 1, state       ) : "active"        ,
						
						  ( 2, displayText ) : "Searoute"      ,  
						  ( 2, pageId      ) : "searoute_map" ,  
						  ( 2, state       ) : "active"        ,
						
						  ( 3, displayText ) : "Gantt"    ,  
						  ( 3, pageId      ) : "planned_routes",  
						  ( 3, state       ) : "active"         
						}
					}
				}
				Parameter p_centerLat;
				Parameter p_centerLon;
			}
			Section Map_Details {
				Procedure pr_OpenPageVisualizeMap {
					Body: {
						for i_used_route /* | i_used_route = first( s_calc_usedRoutes ) */ do
							empty s_locPos ; ! Also empties parameters defined over s_locpos.
							s_locPos := ElementRange(0,1000);
							_ep_locPos := 0 ;
							_ep_loc( _ep_locPos ) := ep_originPortOfVessel( ep_calc_routeVessel(i_used_route) );
							_ep_lastLoc := _ep_loc( _ep_locPos );
							ep_locType( _ep_locPos ) :=   
								if ep_calc_vesselActivityLocation( i_used_route, first( s_calc_legs ) ) = 'sailingDelivery' then
									'loadingHarbor'
								else
									'startHarbor'
								endif ;
						
							_ep_awp := _p_awp ;
							_ep_beg := _ep_awp ;
							p_wpLat(   _ep_awp ) := p_latitude(  _ep_lastLoc );
							p_wpLon(   _ep_awp ) := p_longitude( _ep_lastLoc );
							ep_wpType( _ep_awp ) := ep_locType(  _ep_locPos );
							_p_awp += 1 ;
						
							! collect all locations visited for i_used_route.
							for i_leg_aux | ep_calc_vesselActivityLocation( i_used_route, i_leg_aux ) do
								_ep_nextLoc := ep_calc_vesselActivityLocation( i_used_route, i_leg_aux );
								if _ep_nextLoc <> _ep_lastLoc then
									_ep_locPos += 1 ;
									_ep_loc( _ep_locPos) := _ep_nextLoc ;
						
									if ep_calc_vesselActivityType(i_used_route, i_leg_aux) = 'sailingPickup' then
										ep_locType( _ep_locPos ) := 'loadingHarbor' ;
										_ep_locCargo := ep_calc_vesselActivityCargo(i_used_route, i_leg_aux);
									elseif ep_calc_vesselActivityType(i_used_route, i_leg_aux) = 'idleWaitForCargo' then
										ep_locType( _ep_locPos ) := 'loadingHarbor' ;
										_ep_locCargo := ep_calc_vesselActivityCargo(i_used_route, i_leg_aux);
									elseif ep_calc_vesselActivityType(i_used_route, i_leg_aux) = 'sailingDelivery' then
										ep_locType( _ep_locPos ) := 'deliveryHarbor' ;
										_ep_locCargo := ep_calc_vesselActivityCargo(i_used_route, i_leg_aux);
									endif ;
									sp_def_visibleArcTooltip( _ep_lastLoc, _ep_nextLoc ) :=
										"<div align=\"left\">" +
										"<table border=2px; class=\"left-aligned\"  style=\"margin:0;\">" +
											"<TR>" +
												"<TD>" + "Route: " + "</TD>"  +
												"<TD>" + formatSTring("%e", i_used_route ) + "</TD>"  +
											"</TR>" +
											"<TR>" +
												"<TD>" + "Origin: " + "</TD>"  +
												"<TD>" + formatSTring("%e", _ep_lastLoc ) + "</TD>"  +
											"</TR>" +
											"<TR>" +
												"<TD>" +
												if ep_locType( _ep_locPos ) = 'loadingHarbor' then
													 "Pickup: "
												else
													 "Deliver: "
												endif
												+ "</TD>" +
												"<TD>" + formatString("%e",_ep_locCargo )  + "</TD>"  +
											"</TR>" +
											"<TR>" +
												"<TD>" + "Destination:&nbsp;" + "</TD>"  +
												"<TD>" + formatSTring("%e", _ep_nextLoc ) + "</TD>"  +
											"</TR>" +
										"</table>" ;
									_ep_lastLoc := _ep_nextLoc ;
						
								endif ;
							endfor ;
						endfor ;
					}
					ElementParameter _p_awp {
						Range: s_allWayPoints;
					}
					ElementParameter _ep_locPos {
						Range: s_locPos;
					}
					ElementParameter _ep_loc {
						IndexDomain: i_locpos;
						Range: s_locations;
					}
					ElementParameter _ep_lastLoc {
						Range: s_locations;
					}
					ElementParameter _ep_nextLoc {
						Range: s_locations;
					}
					ElementParameter _ep_awp {
						Range: s_allWayPoints;
					}
					ElementParameter _ep_beg {
						Range: s_allWayPoints;
					}
					ElementParameter _ep_end {
						Range: s_allWayPoints;
					}
					ElementParameter _ep_locCargo {
						Range: s_cargoes;
					}
				}
				Set s_def_visibleLocations {
					SubsetOf: s_locations;
					Index: i_vis_loc, i_vis_locFrom, i_vis_locTo;
					Definition: {
						s_def_visibleDeliveringPorts 
						+ s_def_visibleLoadingPorts
						+ {i_loc | 
						        exists(i_used_route, 
						                bp_selectInUsedRoutes(i_used_route) 
						                and ep_originPortOfVessel(ep_calc_routeVessel(i_used_route)) = i_loc)}
					}
					webui::AnnotationsIdentifier: sp_def_visibleLocationAnnotation(ui::i_vis_loc);
				}
				Set s_def_visibleDeliveringPorts {
					SubsetOf: s_locations;
					Index: i_vis_locDeliv;
					Definition: {
						{ i_loc | 
						    ( i_loc in s_def_deleveringPorts ) and 
						    exists(i_used_route | 
						        bp_def_deliveringLocationsOnRoute(i_used_route, i_loc)
						        and bp_selectInUsedRoutes(i_used_route))}
					}
				}
				Set s_def_visibleLoadingPorts {
					SubsetOf: s_locations;
					Index: i_vis_locLoad;
					Definition: {
						{ i_loc | 
						    ( i_loc in s_def_loadingPorts ) and 
						    exists(i_used_route | 
						        bp_def_loadingLocationsOnRoute(i_used_route, i_loc)
						        and bp_selectInUsedRoutes(i_used_route))}
					}
				}
				Parameter bp_selectInUsedRoutes {
					IndexDomain: i_used_route;
				}
				Parameter p_def_adapLongitude {
					IndexDomain: i_loc;
					Definition: {
						if p_longitude(i_loc) < ( p_centerLon - 180 ) then
							p_longitude(i_loc) + 360
						elseif p_longitude(i_loc) > ( p_centerLon + 180 ) then
							p_longitude(i_loc) - 360
						else
							p_longitude(i_loc)
						endif
					}
				}
				Parameter p_def_visibleArc {
					IndexDomain: (i_loc_from,i_loc_to);
					Definition: {
						sum(i_used_route |
						        bp_selectInUsedRoutes(i_used_route)
						        and p_calc_arcsPerRoute(i_used_route,i_loc_from,i_loc_to), 
						        2 ^ ( 3 * ( ord( i_used_route ) - 1 ) ) * 1)
					}
					webui::TooltipIdentifier: sp_def_visibleArcTooltip;
				}
				Parameter p_def_adapVisibleArc {
					IndexDomain: (i_loc_from,i_loc_to);
					Definition: {
						p_def_visibleArc(i_loc_from,i_loc_to) $
							(abs(p_def_adapLongitude(i_loc_from) - p_def_adapLongitude(i_loc_to)) < 250)
					}
					webui::TooltipIdentifier: sp_def_visibleArcTooltip;
				}
				StringParameter sp_def_visibleArcTooltip {
					IndexDomain: (i_loc_from,i_loc_to);
				}
				StringParameter sp_def_visibleLocationAnnotation {
					IndexDomain: i_vis_loc;
					Definition: "VisibleLocations";
				}
				Parameter p_def_locationNodeSize {
					IndexDomain: i_vis_loc;
					Definition: 3;
				}
			}
			Section Sea_Route_Details {
				Procedure pr_openPageSeaRouteMap {
					Body: {
						!DebuggerBreakpoint();
						empty s_allWayPoints ;
						s_allWayPoints := ElementRange(0,32000);
						_p_awp := 0 ;
						
						! ep_calc_vesselActivityLocation
						pr_scanPythonSource();
						for i_used_route /* | i_used_route = first( s_calc_usedRoutes ) */ do
							empty s_locPos ; ! Also empties parameters defined over s_locpos.
							s_locPos := ElementRange(0,1000);
							_ep_locPos := 0 ;
							_ep_loc( _ep_locPos ) := ep_originPortOfVessel( ep_calc_routeVessel(i_used_route) );
							_ep_lastLoc := _ep_loc( _ep_locPos );
							ep_locType( _ep_locPos ) :=   
								if ep_calc_vesselActivityLocation( i_used_route, first( s_calc_legs ) ) = 'sailingDelivery' then
									'loadingHarbor'
								else
									'startHarbor'
								endif ;
						
							_ep_awp := _p_awp ;
							_ep_beg := _ep_awp ;
							ep_wpLoc(  _ep_awp ) := _ep_lastLoc ;
							sp_wpIconTooltip(  _ep_awp ) := formatString("%e", ep_wpLoc(  _ep_awp ));
							p_wpLat(   _ep_awp ) := p_latitude(  _ep_lastLoc );
							p_wpLon(   _ep_awp ) := p_longitude( _ep_lastLoc );
							ep_wpType( _ep_awp ) := ep_locType(  _ep_locPos );
							_p_awp += 1 ;
						
							! collect all locations visited for i_used_route.
							for i_leg_aux | ep_calc_vesselActivityLocation( i_used_route, i_leg_aux ) do
								_ep_nextLoc := ep_calc_vesselActivityLocation( i_used_route, i_leg_aux );
								if _ep_nextLoc <> _ep_lastLoc then
									_ep_locPos += 1 ;
									_ep_loc( _ep_locPos) := _ep_nextLoc ;
									_ep_locCargo( _ep_locPos ) := ep_calc_vesselActivityCargo(i_used_route, i_leg_aux);
									if ( ep_calc_vesselActivityType(i_used_route, i_leg_aux) = 'sailingPickup'    ) or 
									   ( ep_calc_vesselActivityType(i_used_route, i_leg_aux) = 'idleWaitForCargo' )    then
										ep_locType( _ep_locPos ) := 'loadingHarbor' ;
									elseif ep_calc_vesselActivityType(i_used_route, i_leg_aux) = 'sailingDelivery' then
										ep_locType( _ep_locPos ) := 'deliveryHarbor' ;
									endif ;			
									_ep_lastLoc := _ep_nextLoc ;
								endif ;
							endfor ;
						
							_s_actLocPos := elementRange(0,val(_ep_locPos));
						
							block ! debug code
								empty _s_visitedLocations ;
								for _i_alp do
									_s_visitedLocations += _ep_loc( _i_alp ) ;
								endfor ;
							endblock ;
						
						
							! collect all waypoints visited for i_used_route
							for _i_alp | _i_alp <> first( _s_actLocPos ) do
						
								_ep_fromLoc := _ep_loc( _i_alp - 1 );
								_ep_toloc   := _ep_loc( _i_alp     );
								empty _s_legWaypoints ;
								lpa::pr_getRoute(
									ep_from       :  _ep_fromLoc, 
									ep_to         :  _ep_toloc, 
									p_routeLength :  _p_dummyLen, 
									s_waypoints   :  _s_legWaypoints, 
									p_latWP       :  _p_wayLat, 
									p_lonWP       :  _p_wayLon);
						
								_p_nowaypoints := card( _s_legWaypoints );
								_p_wpLegBeg := _p_awp ;
								_p_wp := 0 ;
								while _p_wp < _p_nowaypoints do
									_ep_wp := _p_wp ;
									_ep_awp := _p_awp ;
									p_wpLat(_ep_awp) :=_p_wayLat( _ep_wp );
									p_wpLon(_ep_awp) :=_p_wayLon( _ep_wp );
									bp_wayPointArc(_ep_awp-1, _ep_awp):= 1 ;
									_p_wp += 1 ;
									_p_awp += 1 ;
								endwhile ;
								_ep_awp := _p_awp ;
								ep_wpLoc(_ep_awp) := _ep_toLoc ;
								sp_wpIconTooltip(  _ep_awp ) := formatString("%e", ep_wpLoc(  _ep_awp ));
								p_wpLat(_ep_awp) := p_latitude(  _ep_toLoc   );
								p_wpLon(_ep_awp) := p_longitude( _ep_toLoc   );
								ep_wpType(_ep_awp) := ep_locType(  _i_alp );
								bp_wayPointArc(_ep_awp-1, _ep_awp):= 1 ;
								_p_wpLegEnd := _p_awp ;
								_p_wpLegMid := round( ( _p_wpLegBeg + _p_wpLegEnd ) / 2 );
								_ep_wpLegMid := _p_wpLegMid ;
								s_waypointsForTooltip := { i_awp | 
									i_awp >  _p_wpLegBeg and
									i_awp <  _p_wpLegEnd  } ;
						
								sp_wpTooltip(    i_wptt-1, i_wptt ) :=  
									"<div align=\"left\">" +
									"<table border=2px; class=\"left-aligned\"  style=\"margin:0;\">" +
										"<TR>" +
											"<TD>" + "Route: " + "</TD>"  +
											"<TD>" + formatSTring("%e", i_used_route ) + "</TD>"  +
										"</TR>" +
										"<TR>" +
											"<TD>" + "Origin: " + "</TD>"  +
											"<TD>" + _ep_fromLoc + "</TD>"  +
										"</TR>" +
										"<TR>" +
											"<TD>" +
											if ep_locType( _ep_locPos ) = 'loadingHarbor' then
												 "Pickup: "
											else
												 "Deliver: "
											endif
											+ "</TD>" +
											"<TD>" + formatString("%e", _ep_locCargo( _ep_locPos ) )  + "</TD>"  +
										"</TR>" +
										"<TR>" +
											"<TD>" + "Destination:&nbsp;" + "</TD>"  +
											"<TD>" + formatSTring("%e", _ep_toloc ) + "</TD>"  +
										"</TR>" +
									"</table>" ;
								sp_wpAnnotation( _ep_wpLegMid-1, _ep_wpLegMid ) := "midleg" ;
						
								_p_awp += 1 ;
						
							endfor ;
							_ep_end := _ep_awp ;
							s_routeWayPoints(i_used_route) := ElementRange( _ep_beg, _ep_end );
						
						endfor ;
						
						p_wpLon(i_awp)|(p_wpLon(i_awp)< -180) += 360 ;
						p_wpLon(i_awp)|(p_wpLon(i_awp)>  180) -= 360 ;
						
						sp_wpIcon( i_awp ) := sp_def_iconLocType( ep_wpType( i_awp ) );
						p_wpIconSize(i_awp) := 1 $ sp_wpIcon( i_awp );
						sp_wpIconAnnotation(i_awp) := "LoadingPort"    $ (sp_wpIcon( i_awp ) and ep_wpType(i_awp) <> 'deliveryHarbor');
						sp_wpIconAnnotation(i_awp) += "DeliveringPort" $ (sp_wpIcon( i_awp ) and ep_wpType(i_awp) =  'deliveryHarbor');
					}
					Comment: {
						"data { 
							idleNothingToDo,  ! Waiting; no more cargos to be handled for this route.
							idleWaitForCargo, ! Waiting in a port for a Cargo to become available.
							sailingPickup,    ! Sailing towards a pickup point.
							sailingDelivery   ! Sailing towards a delivery point.
						}"
					}
					Set _s_visitedLocations {
						SubsetOf: s_locations;
						Index: _i_visLoc;
						OrderBy: user;
					}
					ElementParameter _p_awp {
						Range: s_allWayPoints;
					}
					ElementParameter _ep_locPos {
						Range: s_locPos;
					}
					ElementParameter _ep_loc {
						IndexDomain: i_locpos;
						Range: s_locations;
					}
					ElementParameter _ep_locCargo {
						IndexDomain: i_locpos;
						Range: s_cargoes;
					}
					ElementParameter _ep_lastLoc {
						Range: s_locations;
					}
					ElementParameter _ep_nextLoc {
						Range: s_locations;
					}
					Set _s_actLocPos {
						SubsetOf: Integers;
						Index: _i_alp;
						Property: ElementsAreLabels;
					}
					ElementParameter _ep_fromLoc {
						Range: s_locations;
					}
					ElementParameter _ep_toloc {
						Range: s_locations;
					}
					Parameter _p_dummyLen;
					Set _s_legWaypoints {
						SubsetOf: Integers;
						Index: _i_legWP;
						Property: ElementsAreNumerical;
					}
					Parameter _p_nowaypoints;
					Parameter _p_wayLat {
						IndexDomain: _i_legWP;
					}
					Parameter _p_wayLon {
						IndexDomain: _i_legWP;
					}
					Parameter _p_wp;
					ElementParameter _ep_wp {
						Range: _s_legWaypoints;
					}
					ElementParameter _ep_awp {
						Range: s_allWayPoints;
					}
					ElementParameter _ep_beg {
						Range: s_allWayPoints;
					}
					ElementParameter _ep_end {
						Range: s_allWayPoints;
					}
					Parameter _p_wpLegBeg;
					Parameter _p_wpLegEnd;
					Parameter _p_wpLegMid;
					ElementParameter _ep_wpLegMid {
						Range: s_allWayPoints;
					}
					StringParameter _sp_pyCall;
				}
				Set s_allWayPoints {
					SubsetOf: Integers;
					Index: i_awp, i_awp_from, i_awp_to;
					Property: ElementsAreLabels;
				}
				Set s_def_shownWayPoints {
					SubsetOf: s_allWayPoints;
					Index: i_swp;
					Definition: {
						union( i_used_route | bp_selectInUsedRoutes(i_used_route), 
							s_routeWayPoints(i_used_route) )
					}
				}
				Set s_deliveryWayPoints;
				Set s_loadingWayPoints {
					SubsetOf: s_allWayPoints;
				}
				Set s_waypointsForTooltip {
					SubsetOf: s_allWayPoints;
					Index: i_wptt;
					Property: ElementsAreLabels;
				}
				Set s_locPos {
					SubsetOf: Integers;
					Index: i_locpos;
					Property: ElementsAreLabels;
				}
				ElementParameter ep_locType {
					IndexDomain: i_locpos;
					Range: s_def_waypointTypes;
				}
				Set s_def_waypointTypes {
					Index: i_wpType;
					Definition: data { 'startHarbor', 'loadingHarbor', 'deliveryHarbor' };
				}
				StringParameter sp_def_iconLocType {
					IndexDomain: i_wpType;
					Definition: {
						data { 
							'startHarbor'     : "aimms-ship", 
							'loadingHarbor'   : "aimms-esc", 
							'deliveryHarbor'  : "aimms-enter6"
						}
					}
				}
				Set s_routeWayPoints {
					IndexDomain: i_used_route;
					SubsetOf: s_allWayPoints;
				}
				ElementParameter ep_wpLoc {
					IndexDomain: i_awp;
					Range: s_locations;
				}
				Parameter p_wpLat {
					IndexDomain: i_awp;
				}
				Parameter p_wpLon {
					IndexDomain: i_awp;
				}
				Parameter p_def_wpAdapLon {
					IndexDomain: i_awp;
					Definition: {
						if p_wpLon(i_awp) < ( p_centerLon - 180 ) then
							p_wpLon(i_awp) + 360
						elseif p_wpLon(i_awp) > ( p_centerLon + 180 ) then
							p_wpLon(i_awp) - 360
						else
							p_wpLon(i_awp)
						endif
					}
				}
				ElementParameter ep_wpType {
					IndexDomain: i_awp;
					Range: s_def_waypointTypes;
				}
				StringParameter sp_wpIcon {
					IndexDomain: i_awp;
				}
				Parameter p_wpIconSize {
					IndexDomain: i_awp;
					webui::AnnotationsIdentifier: sp_wpIconAnnotation;
					webui::TooltipIdentifier: sp_wpIconTooltip;
				}
				StringParameter sp_wpIconTooltip {
					IndexDomain: i_awp;
				}
				StringParameter sp_wpIconAnnotation {
					IndexDomain: i_awp;
				}
				Parameter bp_wayPointArc {
					IndexDomain: (i_awp_from, i_awp_to);
					Range: binary;
					webui::AnnotationsIdentifier: sp_wpAnnotation;
					webui::TooltipIdentifier: sp_wpTooltip;
				}
				Parameter bp_def_wayAdapPointArc {
					IndexDomain: (i_awp_from, i_awp_to);
					Range: binary;
					Definition: {
						bp_wayPointArc(i_awp_from, i_awp_to) $
							(abs(p_def_wpAdapLon(i_awp_from)-p_def_wpAdapLon(i_awp_to))<250)
					}
					webui::AnnotationsIdentifier: sp_wpAnnotation;
					webui::TooltipIdentifier: sp_wpTooltip;
				}
				StringParameter sp_wpTooltip {
					IndexDomain: (i_awp_from, i_awp_to);
				}
				StringParameter sp_wpAnnotation {
					IndexDomain: (i_awp_from, i_awp_to);
				}
			}
			Section Gantt_Details {
				StringParameter sp_def_ganttChartStartTime {
					Definition: FormatString("%e", ep_startHorizonDate);
				}
				Parameter p_def_durationCargoOnRoute {
					IndexDomain: (i_act_cargo,i_route);
					Unit: day;
					Definition: (p_def_deleveringTimeCargoRoute(i_act_cargo, i_route) - p_def_loadingTimeCargoRoute(i_act_cargo, i_route))*24;
					webui::ItemTextIdentifier: sp_def_cargoName(i_act_cargo);
					webui::TooltipIdentifier: sp_def_empty;
				}
				Parameter p_def_loadingTimeCargoRouteInHours {
					IndexDomain: (i_act_cargo,i_route);
					Unit: day;
					Definition: p_def_loadingTimeCargoRoute(i_act_cargo, i_route) * 24;
				}
				StringParameter sp_def_cargoName {
					IndexDomain: i_cargo;
					Definition: i_cargo;
				}
			}
		}
	}
	Section Library_Initialization_and_Termination {
		Procedure LibraryInitialization {
			Comment: "Add initialization statements here that do not require any other library being initialized already.";
		}
		Procedure PostLibraryInitialization {
			Body: {
				pr_adaptNamesForPresentationInWebUI();
			}
			Comment: {
				"Add initialization statements here that require another library to be initialized already,
				or add statements that require the Data Management module to be initialized."
			}
		}
		Procedure PreLibraryTermination {
			Body: {
				return 1;
			}
			Comment: {
				"Add termination statements here that require all other libraries to be still alive.
				Return 1 if you allow the termination sequence to continue.
				Return 0 if you want to cancel the termination sequence."
			}
		}
		Procedure LibraryTermination {
			Body: {
				return 1;
			}
			Comment: {
				"Add termination statements here that do not require other libraries to be still alive.
				Return 1 to allow the termination sequence to continue.
				Return 0 if you want to cancel the termination sequence.
				It is recommended to only use the procedure PreLibraryTermination to cancel the termination sequence and let this procedure always return 1."
			}
		}
	}
}
