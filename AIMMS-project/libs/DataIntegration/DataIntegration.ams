## ams_version=1.0

LibraryModule DataIntegration {
	Prefix: di;
	Interface: Public_Section;
	Comment: "Handles all data import and export operations for the Vessel Scheduling application, including reading and writing Excel files and managing random data generation for testing.";
	Section Public_Section {
		Comment: "Publicly accessible declarations and procedures for data import, export, and random data generation.";
		DeclarationSection Generate_Request_File_Declarations {
			Comment: "Parameters controlling the generation of random test input data for the Vessel Scheduling model.";
			Parameter p_noCargos {
				InitialData: 10;
				Comment: "Number of cargoes to generate when creating a random test dataset.";
			}
			Parameter p_noVessels {
				InitialData: 5;
				Comment: "Number of vessels to generate when creating a random test dataset.";
			}
			Parameter p_noMinDaysSailing {
				Unit: day;
				InitialData: 3;
				Comment: "Minimum sailing duration (in days) used when generating random cargo routes.";
			}
			Parameter p_noMaxDaysSailing {
				Unit: day;
				InitialData: 30;
				Comment: "Maximum sailing duration (in days) used when generating random cargo routes.";
			}
			Parameter p_noMinDaysWaiting {
				InitialData: 5;
				Comment: "Minimum number of days a cargo may be waiting within its time window during random data generation.";
			}
			Parameter p_noMaxDaysWaiting {
				InitialData: 60;
				Comment: "Maximum number of days a cargo may be waiting within its time window during random data generation.";
			}
			Parameter p_minCargoCost {
				InitialData: 50;
				Comment: "Minimum fixed cost per cargo used when generating random cargo cost data.";
			}
			Parameter p_maxCargoCost {
				InitialData: 200;
				Comment: "Maximum fixed cost per cargo used when generating random cargo cost data.";
			}
			Parameter p_minCargoSpotCost {
				InitialData: 1e6;
				Comment: "Minimum spot (chartered vessel) cost per cargo used when generating random data.";
			}
			Parameter p_maxCargoSpotCost {
				InitialData: 2e6;
				Comment: "Maximum spot (chartered vessel) cost per cargo used when generating random data.";
			}
			Parameter p_noHorizonDays {
				InitialData: 90;
				Comment: "Length of the planning horizon in days used when generating a random dataset.";
			}
			StringParameter sp_horizonEnd {
				Comment: "Computed end date of the planning horizon, formatted as YYYY-MM-DD, based on the start date and p_noHorizonDays.";
				Definition: {
					MomentToString(
						Format        :  "%c%y-%m-%d",
						unit          :  [day],
						ReferenceDate :  formatString("%e", ep_startHorizonDate),
						Elapsed       :  (p_noHorizonDays)[day]);
				}
			}
			StringParameter sp_generatedFilename {
				Comment: "Name of the Excel file generated for the random dataset, encoding the number of vessels and cargoes in the filename.";
				Definition: formatString("VS_%iVessel_%iCargo.xlsx", ui::p_vesselsQuantity, ui::p_cargoesQuantity);
			}
		}
		Procedure pr_importRequestFile {
			Comment: "Triggers the WebUI file upload dialog, calling pr_importExcel upon completion to read the uploaded Excel input file.";
			Body: {
				webui::RequestFileUpload(onDone : 'di::pr_importExcel' );
			}
		}
		Procedure pr_generateRequestFile {
			Comment: "Clears the current cargo data in preparation for generating a new random dataset.";
			Body: {
				Empty Cargoes ;
			}
		}
		Procedure pr_importExcel {
			Arguments: (fname,statusCode,statusDescription);
			Comment: "WebUI callback procedure invoked after a file is uploaded. Delegates the actual import work to pr_actuallyImportExcel.";
			Body: {

				pr_actuallyImportExcel(fname);
			}
			StringParameter fname {
				Property: Input;
			}
			Parameter statusCode {
				Property: Output;
			}
			StringParameter statusDescription {
				Property: Output;
			}
		}
		Procedure pr_actuallyImportExcel {
			Arguments: (fname);
			Comment: "Performs the actual Excel file import: clears existing data, reads the uploaded file using the generated DEX mapping, activates all master data, and updates the WebUI status bar and workflow state to reflect the successful import.";
			Body: {
				!Delete old data
				empty Cargoes, Vessels, Locations, Routes;
				p_vesselVelocity := 37.04 [km/hour];
				
				block ! import a custom Excel file 
				
				    sp_loc_IOFilePath := webui::GetIOFilePath(fname);
				    dex::DeleteMapping(mappingName : "ImportDataSet");
				
				    dex::AddMapping(
				        mappingName : "ImportDataSet",
				        mappingFile : "Mappings/Generated/ImportDataSet-Excel.xml");
				
				    if dex::ReadFromFile(
				            dataFile : sp_loc_IOFilePath, 
				            mappingName : "ImportDataSet") then
				
				        FileDelete( sp_loc_IOFilePath );
				
				        !Activate all master data
				        bp_activeCargoes(i_cargo):= 1;
				        bp_activeVessels(i_vessel) := 1;
				        bp_activeLocations(i_loc) := 1;
				
				        ! displaying the status message, and logging it in the WebUI messages
				        sp_loc_message := "File was uploaded and read successfully.";
				        webui::ShowMessage('info', sp_loc_message);
				
				        !Changes to secondary actions
				        ui::sp_systemSecondaryActions(3,'state'):= 'active';
				        ui::sp_systemSecondaryActions(4,'state'):= 'inactive';
				
				        !Changes to status bar
				        ui::sp_systemStatusBar(1,'icon') := "aimms-checkmark-circle";
				        ui::sp_systemStatusBar(1,'color') := "Green";
				        ui::sp_systemStatusBar(1,'tooltip') := "Data is succesfully imported.";
				        ui::sp_systemStatusBar(1,'text') := "Data Imported";
				
				        ui::sp_systemStatusBar(3,'color') := "Orange";
				        ui::sp_systemStatusBar(3,'icon'):= "aimms-circle2";
				        ui::sp_systemStatusBar(3,'tooltip') := "Application ready to be solved.";
				        ui::sp_systemStatusBar(3,'state') := "active";
				
				        ui::sp_systemStatusBar(4,'icon'):= "aimms-briefcase";
				        ui::sp_systemStatusBar(4,'text') := fname;
				
				        !Changes to workflow
				        ui::sp_systemWorkflowSteps(1,8,'workflowPageState'):= "inactive";
				        ui::sp_systemWorkflowSteps(1,9,'workflowPageState'):= "inactive";
				        ui::sp_systemWorkflowSteps(1,10,'workflowPageState'):= "inactive";
				
				        !Open Overview dataset
				        ui::sp_systemWorkflowFoldingStates(1, 4, 'openclose') := "open";
				
				    endif;       
				
				onerror ep_err do
				
				    !displaying a custom error message
				    sp_loc_message := "Error when reading file " + errh::Message( ep_err ) + ".";
				    webui::ShowMessage('error', sp_loc_message);
				
				    errh::MarkAsHandled(ep_err) ;
				
				endblock;
			}
			StringParameter fname {
				Property: Input;
			}
			ElementParameter ep_err {
				Range: errh::PendingErrors;
			}
			StringParameter sp_loc_message;
			StringParameter sp_loc_IOFilePath;
		}
		Procedure pr_exportExcelInputFile {
			Comment: "Exports the current input data to an Excel file named 'InputData.xlsx' for download via the WebUI.";
			Body: {

				pr_doWriteExcelInputFile("InputData.xlsx");
			}
		}
		Procedure pr_emptyData {
			Comment: "Empties all data model identifiers and resets the WebUI status bar, workflow steps, and secondary actions to their initial (no-data) state.";
			Body: {
				empty Data_Model;
				
				!Changes to secondary actions
				ui::sp_systemSecondaryActions(3,'state'):= 'inactive';
				ui::sp_systemSecondaryActions(4,'state') := 'inactive';
				
				!Changes to status bar
				ui::sp_systemStatusBar(1,'icon') := "aimms-circle2";
				ui::sp_systemStatusBar(1,'color') := "Orange";
				ui::sp_systemStatusBar(1,'tooltip') := "Click to import Excel file.";
				ui::sp_systemStatusBar(1,'text') := "Import Excel";
				
				ui::sp_systemStatusBar(3,'color') := "red";
				ui::sp_systemStatusBar(3,'icon') := "aimms-cancel-circle2";
				ui::sp_systemStatusBar(3,'tooltip') := "Model not ready to be solved.";
				ui::sp_systemStatusBar(3,'state') := 'inactive';
				
				ui::sp_systemStatusBar(4,'icon'):= "aimms-warning2";
				ui::sp_systemStatusBar(4,'text') := "Nothing Imported";
				
				!Changes to workflow
				ui::sp_systemWorkFlowSteps(1,8,'workflowPageState'):= "inactive";
				ui::sp_systemWorkflowSteps(1,9,'workflowPageState'):= "inactive";
				ui::sp_systemWorkflowSteps(1,10,'workflowPageState'):= "inactive";
			}
		}
		Procedure pr_actuallyExportSolutionFile {
			Comment: "Writes the solution results to 'Results.xlsx' using the DEX export mapping, copies the file to the WebUI IO path, and triggers a file download for the user.";
			Body: {
				sp_loc_fileName := "Results.xlsx";
				
				FileCopy("empty.xlsx", sp_loc_fileName);
				dex::DeleteMapping(mappingName : "ExportResults");
				
				dex::AddMapping(
				    mappingName : "ExportResults",
				    mappingFile : "Mappings/Generated/ExportDataSet-Excel.xml");
				
				! writing the output file locally
				dex::WriteToFile(
				    dataFile    :  sp_loc_fileName, 
					mappingName :  "ExportResults", 
					pretty      :  1);
				
				sp_loc_IOFilePath := webui::GetIOFilePath(sp_loc_fileName);
				
				!this is required so it works on the cloud
				FileCopy(sp_loc_fileName, sp_loc_IOFilePath);
				
				if FileExists(sp_loc_IOFilePath) then
				    webui::RequestFileDownload(sp_loc_IOFilePath);
				    webui::ShowMessage('info',"Export complete.");
				
				else
				    webui::ShowMessage('error',"Something went wrong when creating the file.");
				endif;
			}
			StringParameter sp_loc_fileName;
			StringParameter sp_loc_IOFilePath;
		}
		Procedure pr_doWriteExcelInputFile {
			Arguments: (sp_fn);
			Comment: "Writes current input data to an Excel file with the given filename sp_fn (defaulting to 'InputData.xlsx'), copies it to the WebUI IO path, and triggers a download. Uses the generated ImportDataSet-Excel mapping.";
			Body: {
				if sp_fn then
					sp_loc_fileName := sp_fn ;
				else
					sp_loc_fileName := "InputData.xlsx";
				endif ;
				FileCopy("empty.xlsx", sp_loc_fileName);
				dex::DeleteMapping(mappingName : "ImportDataSet");
				
				dex::AddMapping(
				    mappingName : "ImportDataSet",
				    mappingFile : "Mappings/Generated/ImportDataSet-Excel.xml");
				
				! writing the output file locally
				dex::WriteToFile(
				        dataFile    :  sp_loc_fileName, 
					mappingName :  "ImportDataSet", 
					pretty      :  1);
				
				sp_loc_IOFilePath := webui::GetIOFilePath(sp_loc_fileName);
				
				!this is required so it works on the cloud
				FileCopy(sp_loc_fileName, sp_loc_IOFilePath);
				
				if FileExists(sp_loc_IOFilePath) then
				    webui::RequestFileDownload(sp_loc_IOFilePath);
				    webui::ShowMessage('info',"Export complete.");
				
				else
				    webui::ShowMessage('error',"Something went wrong when creating the file.");
				endif;
			}
			StringParameter sp_fn {
				Property: Input;
			}
			StringParameter sp_loc_IOFilePath;
			StringParameter sp_loc_fileName;
		}
	}
	Section Private_Section {
		Comment: "Internal lifecycle procedures for the DataIntegration library module.";
		Section Library_Initialization_and_Termination {
			Comment: "Standard AIMMS library initialization and termination procedures.";
			Procedure LibraryInitialization {
				Comment: "Add initialization statements here that do not require any other library being initialized already.";
			}
			Procedure PostLibraryInitialization {
				Comment: {
					"Add initialization statements here that require another library to be initialized already,
					or add statements that require the Data Management module to be initialized."
				}
			}
			Procedure PreLibraryTermination {
				Body: {
					return 1;
				}
				Comment: {
					"Add termination statements here that require all other libraries to be still alive.
					Return 1 if you allow the termination sequence to continue.
					Return 0 if you want to cancel the termination sequence."
				}
			}
			Procedure LibraryTermination {
				Body: {
					return 1;
				}
				Comment: {
					"Add termination statements here that do not require other libraries to be still alive.
					Return 1 to allow the termination sequence to continue.
					Return 0 if you want to cancel the termination sequence.
					It is recommended to only use the procedure PreLibraryTermination to cancel the termination sequence and let this procedure always return 1."
				}
			}
		}
	}
}
