## ams_version=1.0

LibraryModule AimmsOpenAPIRunTasks {
	Prefix: oapitasks;
	Interface: Public_Section;
	Section Public_Section {
		Procedure pr_accessInfoLocal {
			Arguments: (port);
			Body: {
				p_port := port ;
				bp_accessInfoProvided := 1 ;
				bp_useCloud := 0 ;
			}
			Parameter port {
				Property: Input;
			}
		}
		Procedure pr_accessInfoCloud {
			Arguments: (cloudname,appname,cloudapikey);
			Body: {
				sp_cloudname := cloudname ;
				sp_cloudappname := appname ;
				sp_cloudapikey := cloudapikey ;
				bp_accessInfoProvided := 1 ;
				bp_useCloud := 1 ;
			}
			StringParameter cloudname {
				Property: Input;
			}
			StringParameter cloudapikey {
				Property: Input;
			}
			StringParameter appname {
				Property: Input;
			}
		}
		Procedure pr_runTask {
			Arguments: (service,request,response);
			Body: {
				block ! sanity checking 
					if not bp_accessInfoProvided then
						raise error "Please provide access info first, either to a local port, or to cloud name, app name, and apikey";
					endif ;
				endblock ;
				
				block ! Set context globals.
					sp_service  := service ;
					sp_request  := request ;
					sp_response := response ;
				endblock ;
				
				block ! Submit
					pr_submitTask();
					pr_awaitCallbackCall();
				endblock ;
				
				block ! Poll
					p_taskStatusUpdates := 0 ;
				
					_bp_over := 0 ;
					while not _bp_over do
						bp_callbackCalled := 0 ;
						p_taskStatusUpdates += 1 ;
				
						pr_requestStatus();
						pr_awaitCallbackCall();
				
						if sp_taskState = "completed" then
							! When the task is finished, the result is available finally as its response and it is time to request that very response.
							pr_requestResponse();
							_bp_over := 1 ;
						elseif sp_taskState = "failed" then
							raise warning formatString( "Task finished with errors: %s", sp_taskStatusErrorMessage );
							_bp_over := 1 ;
						elseif ( ( sp_taskState <> "starting" ) and
						         ( sp_taskState <> "queued"   ) and
						         ( sp_taskState <> "running"  ) and
						         ( sp_taskState <> "solving"  )     ) then
							raise warning formatString("Returned status \"%s\" is an unknown task status; no solution read in and stopped waiting for one.", sp_taskState ) ;
							_bp_over := 1 ;
						endif ;
				
						if not _bp_over then
							delay( 5 /* seconds */ );
						endif ;
				
					endwhile ;
				
				endblock ; 
				
				block ! Response
					pr_requestResponse();
					pr_awaitCallbackCall();
				
				endblock ;
			}
			Parameter _bp_over {
				Range: binary;
			}
			StringParameter service {
				Property: Input;
			}
			StringParameter request {
				Property: Input;
			}
			StringParameter response {
				Property: Input;
			}
		}
	}
	Section Private_Section {
		DeclarationSection internal_library_management {
			Parameter bp_accessInfoProvided {
				Range: binary;
				InitialData: 0;
			}
			Parameter bp_useCloud {
				Range: binary;
				InitialData: 0;
			}
			Parameter bp_usingMemoryStreams {
				InitialData: 0;
			}
			Parameter p_timeBetweenPolls {
				Unit: s;
				InitialData: 4;
			}
			Parameter p_taskStatusUpdates {
				InitialData: 0;
			}
			Parameter bp_callbackCalled {
				Range: binary;
				InitialData: 0;
			}
		}
		DeclarationSection access_info_local {
			Parameter p_port;
		}
		DeclarationSection access_info_cloud {
			StringParameter sp_cloudname {
				InitialData: "<unspecified>";
			}
			StringParameter sp_cloudappname;
			StringParameter sp_cloudapikey;
			StringParameter sp_cloudappversion;
		}
		DeclarationSection context_task_info {
			StringParameter sp_service;
			StringParameter sp_request;
			StringParameter sp_response;
		}
		DeclarationSection status_task_info {
			StringParameter sp_taskID;
			StringParameter sp_taskStatusErrorMessage;
			StringParameter sp_taskState;
		}
		Section Lib_start_stop {
			Procedure LibraryInitialization {
				Comment: "Add initialization statements here that do not require any other library being initialized already.";
			}
			Procedure PostLibraryInitialization {
				Comment: {
					"Add initialization statements here that require another library to be initialized already,
					or add statements that require the Data Management module to be initialized."
				}
			}
			Procedure PreLibraryTermination {
				Body: {
					return 1;
				}
				Comment: {
					"Add termination statements here that require all other libraries to be still alive.
					Return 1 if you allow the termination sequence to continue.
					Return 0 if you want to cancel the termination sequence."
				}
			}
			Procedure LibraryTermination {
				Body: {
					return 1;
				}
				Comment: {
					"Add termination statements here that do not require other libraries to be still alive.
					Return 1 to allow the termination sequence to continue.
					Return 0 if you want to cancel the termination sequence.
					It is recommended to only use the procedure PreLibraryTermination to cancel the termination sequence and let this procedure always return 1."
				}
			}
		}
		Section submit {
			Procedure pr_submitTask {
				Body: {
					! Prepping input.
					bp_callbackCalled := 0 ;
					if bp_useCloud then
						AIMMSPRO::api::apiServer := formatString("https://%s/pro-api/v2", sp_cloudname) ;
						AIMMSPRO::api::APIKey(AIMMSPRO::api::secscheme) := sp_cloudapikey ;
					else
						AIMMSPRO::api::apiServer := formatString("http://localhost:%i/api/v2", p_port) ;
					endif ;
					if bp_usingMemoryStreams then
						AIMMSPRO::api::RequestResponseFilePrefix := "##" ;
					else
						if DirectoryExists( "RequestResponseFiles" ) then
							AIMMSPRO::api::RequestResponseFilePrefix := "RequestResponseFiles/" ;
						else
							raise warning "Folder RequestResponseFiles doesn't exist; using project folder instead to store request and response files." ;
							AIMMSPRO::api::RequestResponseFilePrefix := "./" ;
						endif ;
					endif ;
					
					! Starting current call.
					AIMMSPRO::api::NewCallInstance(_ep_oaimmsCallInstance);
					pr_log(formatString("pr_submitTask, instance %e, request filename: %s", _ep_oaimmsCallInstance, _sp_requestFilename ));
					
					! Specify where input(request input data) is read from
					AIMMSPRO::api::RequestFile(_ep_oaimmsCallInstance,'requestbody') := sp_request ;
					
					! When ok, this response hook starts polling for task status.
					AIMMSPRO::api::create_task::UserResponseHook :=  'oapitasks::pr_submitTaskHook' ;
					AIMMSPRO::api::create_task_latest_version::UserResponseHook := 'oapitasks::pr_submitTaskHook' ;
					
					! Actually make the request to start a task:
					if sp_cloudappversion then
						AIMMSPRO::api::create_task::apiCall(
							callInstance :  _ep_oaimmsCallInstance, 
							appName      :  sp_cloudappname, 
							appVersion   :  sp_cloudappversion, 
							serviceName  :  sp_service );
					else
						AIMMSPRO::api::create_task_latest_version::apiCall(
							callInstance :  _ep_oaimmsCallInstance, 
							appName      :  sp_cloudappname, 
							serviceName  :  sp_service );
					endif;
				}
				ElementParameter _ep_oaimmsCallInstance {
					Range: AIMMSPRO::Instances;
				}
				StringParameter _sp_requestFilename;
			}
			Procedure pr_submitTaskHook {
				Arguments: (ep_callInstance);
				Body: {
					bp_callbackCalled := 1 ;
					
					_ep_callStatCode := AIMMSPRO::api::CallStatusCode(ep_callInstance) ;
					pr_log(formatString("oapitasks::pr_submitTaskHook(%e), code: %e", ep_callInstance, _ep_callStatCode));
					!	{ AIMMSPRO::api::CallStatusCode, AIMMSPRO::api::CallErrorCode, AIMMSPRO::_ErrorMessage::message } ;
					
					if _ep_callStatCode = '200' then
						sp_taskID := AIMMSPRO::_Task::id(ep_callInstance);
						pr_log(formatString("sp_taskID := \"%s\"",sp_taskID ));
						pr_requestStatus();
					else
						raise error formatString("oapitasks::create_task(\"%s\",\"%s\",\"%s\") failed (status: %e, error: %i): %s",
							sp_cloudname, sp_cloudappversion, sp_service, 
							AIMMSPRO::api::CallStatusCode(ep_callInstance), 
							AIMMSPRO::api::CallErrorCode(ep_callInstance), 
							AIMMSPRO::_ErrorMessage::message(ep_callInstance) ) ;
					endif ;
				}
				ElementParameter ep_callInstance {
					Range: AIMMSPRO::Instances;
					Property: Input;
				}
				ElementParameter _ep_callStatCode {
					Range: dex::HTTPStatusCodes;
				}
			}
		}
		Section poll {
			Procedure pr_requestStatus {
				Body: {
					bp_callbackCalled := 0 ;
					
					! Starting current call.
					AIMMSPRO::api::NewCallInstance(_ep_oaimmsCallInstance);
					
					! This hook will continue inquiring until the task is finished.
					AIMMSPRO::api::get_task::UserResponseHook := 
						'oapitasks::pr_requestStatusHook' ;
					
					! Actually request task status.
					AIMMSPRO::api::get_task::apiCall(
						callInstance :  _ep_oaimmsCallInstance, 
						id           :  sp_taskID);
				}
				ElementParameter _ep_oaimmsCallInstance {
					Range: AIMMSPRO::Instances;
				}
			}
			Procedure pr_requestStatusHook {
				Arguments: (ep_callInstance);
				Body: {
					bp_callbackCalled := 1 ;
					_ep_callStatCode := AIMMSPRO::api::CallStatusCode(ep_callInstance);
					pr_log(formatString("oapitasks::pr_requestStatusHook(%e), status code=%e", ep_callInstance, _ep_callStatCode ));
					
					switch _ep_callStatCode do
					
						'200':
							! Copy the current task status detail information to the identifiers used in the WebUI.
							sp_taskStatusErrorMessage := AIMMSPRO::_Task::errormessage(ep_callInstance);
							sp_taskState              := AIMMSPRO::_Task::state(ep_callInstance);
							pr_log(formatString("task: %s, task status: %s", sp_taskID, sp_taskState ));
					
						'400', '401', '402', '403', '404', '405', '406', '407', '408', '409', '410', '411', '412', '413', '414', '415', '416', '417', '421', '422', '423', '424', '425', '426', '427', '428', '429', '431', '451':
						'500', '501', '502', '503', '504', '505', '506', '507', '508', '510', '511':
							raise error formatString("oapitasks::makeRequest(%s,%s,%s) - %s - failed (status: %e, error: %e): %s",
								sp_cloudappname, sp_cloudappversion, sp_service, sp_taskID,
								AIMMSPRO::api::CallStatusCode(ep_callInstance), 
								AIMMSPRO::api::CallErrorCode(ep_callInstance), 
								AIMMSPRO::_ErrorMessage::message(ep_callInstance) ) ;
					
						default:
							raise error formatString("oapitasks::makeRequest(%s,%s,%s) - %s - failed (status: %e, error: %e): unknown status - no error info from server available",
								sp_cloudappname, sp_cloudappversion, sp_service, sp_taskID,
								AIMMSPRO::api::CallStatusCode(ep_callInstance), 
								AIMMSPRO::api::CallErrorCode(ep_callInstance) ) ;
					
					endswitch;
				}
				ElementParameter ep_callInstance {
					Range: AIMMSPRO::Instances;
					Property: Input;
				}
				ElementParameter _ep_callStatCode {
					Range: dex::HTTPStatusCodes;
				}
			}
			Procedure pr_awaitCallbackCall {
				Body: {
					_ep_stopwatch := Element( stopwatch::s_stopwatches, 3 );
					stopwatch::pr_start(_ep_stopwatch);
					_p_elapsed := 0[s] ;
					while _p_elapsed <= 60[s] do
						if bp_callbackCalled then
							break ;
						else 
							_p_wfr := dex::client::WaitForResponses( 100 /* milli seconds */ );
							_p_elapsed := stopwatch::fnc_elapsed( _ep_stopwatch );
						endif ;
					endwhile ;
					if not bp_callbackCalled then
						raise error "No callback within one minute" ;
					endif ;
				}
				ElementParameter _ep_stopwatch {
					Range: stopwatch::s_stopwatches;
				}
				Parameter _p_elapsed {
					Unit: s;
				}
				Parameter _p_wfr;
			}
		}
		Section response {
			Procedure pr_requestResponse {
				Body: {
					bp_callbackCalled := 0 ;
					
					! Starting current call.
					AIMMSPRO::api::NewCallInstance(_ep_oaimmsCallInstance);
					
					! This hook will call the actual hook to read the results (in case of no error).
					AIMMSPRO::api::get_task_response::UserResponseHook := 
						'oapitasks::pr_requestResponseHook' ;
					
					! The callback should not attempt to read the data upon success.
					! instead, the callback should leave that work up to the response hook.
					AIMMSPRO::api::get_task_response::DeserializeResponse( '200' ) := 0 ;
					! Note that the response hook will use the location: AIMMSPRO::api::get_task_response::ResponseFile(ep_callInstance,'responseBody')
					
					! Actually request task response.
					AIMMSPRO::api::get_task_response::apiCall(
						callInstance :  _ep_oaimmsCallInstance, 
						id           :  sp_taskID);
				}
				ElementParameter _ep_oaimmsCallInstance {
					Range: AIMMSPRO::Instances;
				}
				StringParameter _sp_responseFilename;
				StringParameter _sp_responseMapping;
			}
			Procedure pr_requestResponseHook {
				Arguments: (ep_callInstance);
				Body: {
					bp_callbackCalled := 1 ;
					_ep_callStatCode := AIMMSPRO::api::CallStatusCode(ep_callInstance);
					
					pr_log(formatString("oapitasks::pr_requestResponseHook(%e), status code=%e", ep_callInstance, _ep_callStatCode ));
					
					switch _ep_callStatCode do
					
						'200':
							_sp_responseFilename := AIMMSPRO::api::ResponseFile(ep_callInstance,'responseBody');
							pr_log(formatString("oapitasks::pr_requestResponseHook(%e): file: %s, map: %s", 
								ep_callInstance, _sp_responseFilename, _sp_responseMapping ) );
							FileCopy( _sp_responseFilename, sp_response );
					
						'400', '401', '402', '403', '404', '405', '406', '407', '408', '409', '410', '411', '412', '413', '414', '415', '416', '417', '421', '422', '423', '424', '425', '426', '427', '428', '429', '431', '451':
						'500', '501', '502', '503', '504', '505', '506', '507', '508', '510', '511':
							raise error formatString("oapitasks::requestResponse(%s,%s,%s) - %s - failed (status: %e, error: %e): %s",
								sp_cloudappname, sp_cloudappversion, sp_service, sp_taskID,
								AIMMSPRO::api::CallStatusCode(ep_callInstance), 
								AIMMSPRO::api::CallErrorCode(ep_callInstance), 
								AIMMSPRO::_ErrorMessage::message(ep_callInstance) ) ;
					
						default:
							raise error formatString("oapitasks::requestResponse(%s,%s,%s) - %s - failed (status: %e, error: %e): unknown status - no error info from server available",
								sp_cloudappname, sp_cloudappversion, sp_service, sp_taskID,
								AIMMSPRO::api::CallStatusCode(ep_callInstance), 
								AIMMSPRO::api::CallErrorCode(ep_callInstance) ) ;
					
					endswitch;
				}
				ElementParameter ep_callInstance {
					Range: AIMMSPRO::Instances;
					Property: Input;
				}
				StringParameter _sp_responseFilename;
				StringParameter _sp_responseMapping;
				ElementParameter _ep_callStatCode {
					Range: dex::HTTPStatusCodes;
				}
			}
		}
		Section Error_response {
			Procedure pr_requestErrorResponse {
				Body: {
					raise error "pr_requestErrorResponse(): not implemented yet." ;
				}
			}
		}
		Section Logging_and_debugging {
			StringParameter sp_logFilename {
				Definition: "log/openapitasks.log";
			}
			File f_logfile {
				Device: Disk;
				Mode: merge;
			}
			StringParameter sp_app {
				Definition: "[app]";
			}
			Function fnc_now {
				Range: string;
				Body: {
					_sp_retval := CurrentToString("%c%y-%m-%d %H:%M:%S%TZ('UTC')");
					fnc_now := _sp_retval ;
				}
				StringParameter _sp_retval;
			}
			Procedure pr_log {
				Arguments: (sp_msg);
				Body: {
					if pro::GetPROEndPoint() then
						pro::management::LocalLogInfo(sp_app+" "+sp_msg);
					else
						_sp_now := fnc_now();
						put f_logfile ;
						put _sp_now, " ", sp_app, " ", sp_msg, /;
						putclose ;
					endif ;
				}
				StringParameter sp_msg {
					Property: Input;
				}
				StringParameter _sp_now;
			}
		}
	}
}
